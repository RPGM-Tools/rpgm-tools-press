---
/**
 * A simple candle/flame glyph. currentColor-based; pair with
 * --rpgm-shadow-candle on the wrapping element for the "glow" effect.
 * The flame flickers on its own by default - pass animate={false} for a
 * static rendering (e.g. printed contexts, or a spot too small/brief to
 * be worth it). Respects prefers-reduced-motion globally (base.css), not
 * re-guarded here.
 */
interface Props {
  color?: string;
  size?: number | string;
  animate?: boolean;
  class?: string;
}

const { color = "currentColor", size = 24, animate = true, class: className } = Astro.props;
const px = typeof size === "number" ? `${size}px` : size;
---

<svg
  class:list={["rpgm-candle", className]}
  viewBox="0 0 24 32"
  width={px}
  height={px}
  fill="none"
  stroke={color}
  stroke-width="1.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  role="presentation"
  aria-hidden="true"
>
  <path
    class:list={{ "rpgm-candle__flame": animate }}
    d="M12 3 C13.5 6 15 8.2 15 10.5 C15 12.4 13.7 13.6 12 13.6 C10.3 13.6 9 12.4 9 10.5 C9 8.2 10.5 6 12 3 Z"
    fill={color}
    stroke="none"
    opacity="0.9"
  />
  <path d="M12 13.6 V16" />
  <rect x="8" y="16" width="8" height="12" rx="1" />
  <path d="M8 20 H16" opacity="0.6" />
  <path d="M6 28 H18" stroke-width="1.2" opacity="0.7" />
</svg>

<style>
  .rpgm-candle__flame {
    transform-origin: 12px 8px;
    animation: rpgm-flicker 2.6s ease-in-out infinite;
  }

  @keyframes rpgm-flicker {
    0%, 100% { opacity: 0.9; transform: scale(1) skewX(0deg); }
    25% { opacity: 1; transform: scale(1.04, 0.97) skewX(-1deg); }
    50% { opacity: 0.82; transform: scale(0.97, 1.03) skewX(1deg); }
    75% { opacity: 0.96; transform: scale(1.02, 0.99) skewX(-0.5deg); }
  }
</style>
