---
/**
 * A simple candle/flame glyph. currentColor-based; pair with
 * --rpgm-shadow-candle on the wrapping element for the "glow" effect.
 */
interface Props {
  color?: string;
  size?: number | string;
  class?: string;
}

const { color = "currentColor", size = 24, class: className } = Astro.props;
const px = typeof size === "number" ? `${size}px` : size;
---

<svg
  class={className}
  viewBox="0 0 24 32"
  width={px}
  height={px}
  fill="none"
  stroke={color}
  stroke-width="1.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  role="presentation"
  aria-hidden="true"
>
  <path
    d="M12 3 C13.5 6 15 8.2 15 10.5 C15 12.4 13.7 13.6 12 13.6 C10.3 13.6 9 12.4 9 10.5 C9 8.2 10.5 6 12 3 Z"
    fill={color}
    stroke="none"
    opacity="0.9"
  />
  <path d="M12 13.6 V16" />
  <rect x="8" y="16" width="8" height="12" rx="1" />
  <path d="M8 20 H16" opacity="0.6" />
  <path d="M6 28 H18" stroke-width="1.2" opacity="0.7" />
</svg>
