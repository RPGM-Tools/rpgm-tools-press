---
/**
 * A small wax-seal-like circular emblem. currentColor-based.
 */
interface Props {
  color?: string;
  size?: number | string;
  class?: string;
}

const { color = "currentColor", size = 32, class: className } = Astro.props;
const px = typeof size === "number" ? `${size}px` : size;
---

<svg
  class={className}
  viewBox="0 0 48 48"
  width={px}
  height={px}
  fill="none"
  stroke={color}
  role="presentation"
  aria-hidden="true"
>
  <circle cx="24" cy="24" r="21" stroke-width="1.6" />
  <circle cx="24" cy="24" r="16" stroke-width="1" stroke-dasharray="2 3" />
  <path
    d="M24 14 L27 21 L34.5 21.5 L28.8 26.3 L30.7 33.6 L24 29.6 L17.3 33.6 L19.2 26.3 L13.5 21.5 L21 21 Z"
    stroke-width="1.4"
    stroke-linejoin="round"
  />
</svg>
