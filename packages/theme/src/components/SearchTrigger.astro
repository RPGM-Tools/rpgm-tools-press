---
/**
 * Search trigger + mount point for Pagefind's bundled UI.
 *
 * Pagefind runs as a postbuild step (`pagefind --site dist`) that emits
 * /pagefind/pagefind-ui.js + .css alongside the rest of the static output -
 * there's no npm UI package to import here. The client script below fetches
 * those two files lazily, only once the panel is first opened, so search's
 * JS/CSS never blocks first paint.
 */
interface Props {
  label?: string;
}

const { label = "Search" } = Astro.props;
---

<div class="rpgm-search-trigger" data-rpgm-search-trigger>
  <button type="button" class="rpgm-search-trigger__button" aria-haspopup="dialog" aria-controls="pagefind-search">
    <svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
      <circle cx="8.5" cy="8.5" r="6" />
      <path d="M13 13 L18 18" stroke-linecap="round" />
    </svg>
    <span>{label}</span>
  </button>
  <div id="pagefind-search" class="rpgm-search-trigger__panel" hidden></div>
</div>

<script>
  let pagefindLoaded: Promise<void> | null = null;

  function loadPagefindUI(): Promise<void> {
    if (pagefindLoaded) return pagefindLoaded;

    pagefindLoaded = (async () => {
      await new Promise<void>((resolve, reject) => {
        const link = document.createElement("link");
        link.rel = "stylesheet";
        link.href = "/pagefind/pagefind-ui.css";
        link.onload = () => resolve();
        link.onerror = () => reject(new Error("failed to load pagefind-ui.css"));
        document.head.appendChild(link);
      });

      await new Promise<void>((resolve, reject) => {
        const script = document.createElement("script");
        script.src = "/pagefind/pagefind-ui.js";
        script.onload = () => resolve();
        script.onerror = () => reject(new Error("failed to load pagefind-ui.js"));
        document.body.appendChild(script);
      });

      // eslint-disable-next-line @typescript-eslint/no-explicit-any
      new (window as any).PagefindUI({
        element: "#pagefind-search",
        showSubResults: true,
        showImages: false,
      });
    })();

    return pagefindLoaded;
  }

  document.querySelectorAll<HTMLElement>("[data-rpgm-search-trigger]").forEach((trigger) => {
    const button = trigger.querySelector("button");
    const panel = trigger.querySelector<HTMLElement>("#pagefind-search");
    if (!button || !panel) return;

    button.addEventListener("click", async () => {
      const opening = panel.hidden;
      panel.hidden = !opening;
      if (opening) {
        await loadPagefindUI();
        panel.querySelector("input")?.focus();
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !panel.hidden) {
        panel.hidden = true;
        button.focus();
      }
    });
  });
</script>

<style>
  .rpgm-search-trigger {
    position: relative;
  }

  .rpgm-search-trigger__button {
    display: inline-flex;
    align-items: center;
    gap: var(--rpgm-space-2);
    background: transparent;
    border: 1px solid var(--rpgm-border);
    border-radius: var(--rpgm-radius-full);
    color: var(--rpgm-text-muted);
    font-family: var(--rpgm-font-body);
    font-size: var(--rpgm-text-sm);
    padding: 0.4em 0.9em;
    cursor: pointer;
    transition: border-color var(--rpgm-transition-fast), color var(--rpgm-transition-fast), box-shadow var(--rpgm-transition-glow);
  }

  .rpgm-search-trigger__button:hover,
  .rpgm-search-trigger__button:focus-visible {
    color: var(--rpgm-accent);
    border-color: var(--rpgm-border-strong);
    box-shadow: var(--rpgm-shadow-candle);
  }

  .rpgm-search-trigger__panel {
    position: absolute;
    top: calc(100% + var(--rpgm-space-2));
    right: 0;
    min-width: 20rem;
    z-index: 20;
  }
</style>
