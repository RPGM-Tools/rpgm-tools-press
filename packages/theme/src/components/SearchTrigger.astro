---
/**
 * Search trigger + mount point for Pagefind's bundled UI.
 *
 * Pagefind runs as a postbuild step (`pagefind --site dist`) that emits
 * /pagefind/pagefind-ui.js + .css alongside the rest of the static output -
 * there's no npm UI package to import here. The client script below fetches
 * those two files lazily, only once the panel is first opened, so search's
 * JS/CSS never blocks first paint.
 */
interface Props {
  label?: string;
}

const { label = "Search" } = Astro.props;
---

<div class="rpgm-search-trigger" data-rpgm-search-trigger>
  <button type="button" class="rpgm-search-trigger__button" aria-haspopup="dialog" aria-controls="pagefind-search">
    <svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
      <circle cx="8.5" cy="8.5" r="6" />
      <path d="M13 13 L18 18" stroke-linecap="round" />
    </svg>
    <span>{label}</span>
    <kbd class="rpgm-search-trigger__kbd" aria-hidden="true">/</kbd>
  </button>
  <div id="pagefind-search" class="rpgm-search-trigger__panel" hidden></div>
</div>

<script>
  let pagefindLoaded: Promise<void> | null = null;

  function loadPagefindUI(): Promise<void> {
    if (pagefindLoaded) return pagefindLoaded;

    pagefindLoaded = (async () => {
      await new Promise<void>((resolve, reject) => {
        const link = document.createElement("link");
        link.rel = "stylesheet";
        link.href = "/pagefind/pagefind-ui.css";
        link.onload = () => resolve();
        link.onerror = () => reject(new Error("failed to load pagefind-ui.css"));
        document.head.appendChild(link);
      });

      await new Promise<void>((resolve, reject) => {
        const script = document.createElement("script");
        script.src = "/pagefind/pagefind-ui.js";
        script.onload = () => resolve();
        script.onerror = () => reject(new Error("failed to load pagefind-ui.js"));
        document.body.appendChild(script);
      });

      /*
       * `filters` just gives the auto-detected data-pagefind-filter facets
       * (tag/category, on blog posts) a fixed display order + heading -
       * Pagefind still auto-discovers whatever facets exist on a given
       * site, so this is a no-op (no filter panel at all) on the releases
       * site, which doesn't tag its entries this way.
       * Ranking (exact match, then prefix, then a fuzzy edit-distance
       * fallback) is Pagefind's own default behavior, not configured here.
       */
      // eslint-disable-next-line @typescript-eslint/no-explicit-any
      new (window as any).PagefindUI({
        element: "#pagefind-search",
        showSubResults: true,
        showImages: false,
        showEmptyFilters: false,
        filters: { category: "Category", tag: "Tag" },
      });
    })();

    return pagefindLoaded;
  }

  document.querySelectorAll<HTMLElement>("[data-rpgm-search-trigger]").forEach((trigger) => {
    const button = trigger.querySelector("button");
    const panel = trigger.querySelector<HTMLElement>("#pagefind-search");
    if (!button || !panel) return;

    async function open() {
      if (!panel!.hidden) return;
      // The button IS the search field, once open - hiding it rather than
      // leaving it sitting there next to a second, separately-appearing
      // input would read as two different controls for one action.
      button!.hidden = true;
      panel!.hidden = false;
      await loadPagefindUI();
      panel!.querySelector("input")?.focus();
    }

    function close({ refocus = false } = {}) {
      if (panel!.hidden) return;
      panel!.hidden = true;
      button!.hidden = false;
      if (refocus) button!.focus();
    }

    button!.addEventListener("click", () => {
      if (panel!.hidden) void open();
      else close();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !panel!.hidden) {
        close({ refocus: true });
        return;
      }

      // "/" opens search from anywhere, unless the user is already typing
      // (an input/textarea/contenteditable) or chording a modifier key -
      // a lone "/" should never hijack a slash someone meant to type.
      if (
        event.key === "/" &&
        panel!.hidden &&
        !event.ctrlKey &&
        !event.metaKey &&
        !event.altKey
      ) {
        const target = event.target as HTMLElement | null;
        const tag = target?.tagName;
        const isTyping =
          tag === "INPUT" || tag === "TEXTAREA" || target?.isContentEditable;
        if (!isTyping) {
          event.preventDefault();
          void open();
        }
      }
    });

    document.addEventListener("click", (event) => {
      if (panel!.hidden) return;
      if (trigger.contains(event.target as Node)) return;
      close();
    });
  });
</script>

<style>
  .rpgm-search-trigger {
    position: relative;
  }

  /*
   * While open, let the trigger actually claim layout space instead of the
   * panel floating over the header in an absolutely-positioned box (below) -
   * that used to overlay the nav links and logo to its left rather than
   * pushing them out of the way. Growing this flex item (its siblings in
   * .rpgm-header__right can wrap thanks to that row's own flex-wrap) is what
   * makes room for it honestly.
   */
  .rpgm-search-trigger:has(#pagefind-search:not([hidden])) {
    flex: 1 1 18rem;
    max-width: 32rem;
    min-width: 0;
  }

  /*
   * The attribute selector below needs to out-specificity the plain class
   * rule, because author-stylesheet rules always beat the UA stylesheet's
   * own `[hidden] { display: none }` regardless of specificity - setting
   * `button.hidden = true` from the script had no visual effect at all
   * until now. It went unnoticed while the panel was absolutely positioned
   * on top of the (still-visible) button; once the panel became a normal
   * in-flow element (see .rpgm-search-trigger__panel below), both showed
   * at once.
   */
  .rpgm-search-trigger__button[hidden] {
    display: none;
  }

  .rpgm-search-trigger__button {
    display: inline-flex;
    align-items: center;
    gap: var(--rpgm-space-2);
    background: transparent;
    border: 1px solid var(--rpgm-border);
    border-radius: var(--rpgm-radius-full);
    color: var(--rpgm-text-muted);
    font-family: var(--rpgm-font-body);
    font-size: var(--rpgm-text-sm);
    padding: 0.4em 0.9em;
    cursor: pointer;
    transition: border-color var(--rpgm-transition-fast), color var(--rpgm-transition-fast), box-shadow var(--rpgm-transition-glow);
  }

  .rpgm-search-trigger__button:hover,
  .rpgm-search-trigger__button:focus-visible {
    color: var(--rpgm-accent);
    border-color: var(--rpgm-border-strong);
    box-shadow: var(--rpgm-shadow-candle);
  }

  .rpgm-search-trigger__kbd {
    font-family: var(--rpgm-font-mono);
    font-size: 0.7em;
    line-height: 1;
    color: var(--rpgm-text-muted);
    background: var(--rpgm-bg);
    border: 1px solid var(--rpgm-border);
    border-radius: var(--rpgm-radius-sm);
    padding: 0.15em 0.4em;
  }

  /*
   * Normal flow, not absolutely positioned: an overlaid panel doesn't
   * displace anything, so on any header too narrow to spare 20+rem next to
   * it (i.e. most of them), it just draws on top of the nav links and logo
   * to its left. Sitting in-flow, sized by the wrapper's own flex-grow
   * above, means the header genuinely reflows around it instead.
   */
  .rpgm-search-trigger__panel {
    width: 100%;
  }

  /*
   * Pagefind ships its own default (light, generic) look via
   * pagefind-ui.css. These custom properties are its documented theming
   * hook - retargeting them here is how the search panel ends up reading
   * as part of this theme instead of a bolted-on third-party widget.
   */
  .rpgm-search-trigger__panel :global(.pagefind-ui) {
    --pagefind-ui-primary: var(--rpgm-accent);
    --pagefind-ui-text: var(--rpgm-text);
    --pagefind-ui-background: var(--rpgm-surface);
    --pagefind-ui-border: var(--rpgm-border-strong);
    --pagefind-ui-tag: var(--rpgm-border);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 999px;
    --pagefind-ui-font: var(--rpgm-font-body);
  }

  /* The input row itself takes over the button's exact pill shape - this is the part standing where the button was. */
  .rpgm-search-trigger__panel :global(.pagefind-ui__form) {
    border-radius: var(--rpgm-radius-full);
    box-shadow: var(--rpgm-shadow-candle);
  }

  .rpgm-search-trigger__panel :global(.pagefind-ui__search-input) {
    font-family: var(--rpgm-font-body);
    padding-top: 0.6em;
    padding-bottom: 0.6em;
  }

  /* Results/filters drop below the input pill as their own elevated sheet, not fused to it. */
  .rpgm-search-trigger__panel :global(.pagefind-ui__drawer) {
    margin-top: var(--rpgm-space-2);
    padding: var(--rpgm-space-3);
    background: var(--rpgm-surface);
    border: 1px solid var(--rpgm-border-strong);
    border-radius: var(--rpgm-radius-lg);
    box-shadow: var(--rpgm-shadow-elevated);
    max-height: 65vh;
    overflow-y: auto;
  }

  .rpgm-search-trigger__panel :global(.pagefind-ui__result-title) {
    font-family: var(--rpgm-font-display);
  }

  /* Pagefind's own match-highlight <mark>, not covered by its CSS vars - default browser yellow reads as a jarring foreign color against this palette. */
  .rpgm-search-trigger__panel :global(mark) {
    background: color-mix(in srgb, var(--rpgm-accent) 45%, transparent);
    color: var(--rpgm-text);
    border-radius: 2px;
  }
</style>
