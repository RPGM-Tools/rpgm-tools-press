---
export interface NavLink {
  label: string;
  href: string;
}

interface Props {
  links: NavLink[];
  class?: string;
}

const { links, class: className } = Astro.props;
const currentPath = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === "/") return currentPath === "/";
  return currentPath === href || currentPath.startsWith(`${href}/`);
}
---

<nav class:list={["rpgm-nav", className]} aria-label="Primary">
  <ul class="rpgm-nav__list">
    {
      links.map((link) => (
        <li>
          <a
            href={link.href}
            class="rpgm-nav__link"
            aria-current={isActive(link.href) ? "page" : undefined}
          >
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .rpgm-nav__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--rpgm-space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rpgm-nav__link {
    font-family: var(--rpgm-font-display);
    font-size: var(--rpgm-text-base);
    color: var(--rpgm-text-muted);
    text-decoration: none;
    padding-bottom: 2px;
    border-bottom: 1px solid transparent;
    transition: color var(--rpgm-transition-fast), border-color var(--rpgm-transition-fast);
  }

  .rpgm-nav__link:hover,
  .rpgm-nav__link:focus-visible {
    color: var(--rpgm-accent);
    border-bottom-color: var(--rpgm-accent);
  }

  .rpgm-nav__link[aria-current="page"] {
    color: var(--rpgm-accent);
    border-bottom-color: var(--rpgm-accent);
  }
</style>
