---
import type { NavLink } from "./Nav.astro";
import Flourish from "../ornaments/Flourish.astro";

interface Props {
  siteTitle: string;
  links?: NavLink[];
  /** RSS feed path, if this app has one - added as an extra footer link. */
  rssHref?: string;
  /** Link to this site's own source repo - added as an extra footer link. */
  githubHref?: string;
}

const { siteTitle, links = [], rssHref, githubHref } = Astro.props;
const year = new Date().getFullYear();

const allLinks: NavLink[] = [
  ...links,
  ...(rssHref ? [{ label: "RSS", href: rssHref }] : []),
  ...(githubHref ? [{ label: "Source", href: githubHref }] : []),
];
---

<footer class="rpgm-footer">
  <div class="rpgm-footer__inner">
    <div class="rpgm-footer__flourish-wrap">
      <Flourish maxWidth="16rem" color="var(--rpgm-border-strong)" size={18} />
    </div>
    <div class="rpgm-footer__row">
      <p class="rpgm-footer__site">{siteTitle}</p>
      {
        allLinks.length > 0 && (
          <ul class="rpgm-footer__links">
            {allLinks.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
    <a href="https://rpgm.tools" class="rpgm-footer__brand">
      <img src="/rpgm-tools-logo.webp" alt="" width="48" height="48" class="rpgm-footer__brand-logo" />
      <span class="rpgm-footer__brand-copy">&copy; {year} RPGM Tools, LLC.</span>
    </a>
  </div>
</footer>

<style>
  .rpgm-footer {
    border-top: 1px solid var(--rpgm-border);
    background: var(--rpgm-bg-elevated);
    margin-top: var(--rpgm-space-8);
  }

  .rpgm-footer__inner {
    max-width: 76rem;
    margin: 0 auto;
    padding: var(--rpgm-space-6) var(--rpgm-space-5) var(--rpgm-space-7);
  }

  .rpgm-footer__flourish-wrap {
    margin-bottom: var(--rpgm-space-5);
  }

  .rpgm-footer__row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--rpgm-space-4);
    align-items: center;
    justify-content: space-between;
  }

  .rpgm-footer__site {
    margin: 0;
    font-family: var(--rpgm-font-display);
    font-size: var(--rpgm-text-sm);
    color: var(--rpgm-text-muted);
  }

  .rpgm-footer__links {
    display: flex;
    gap: var(--rpgm-space-4);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--rpgm-text-sm);
  }

  .rpgm-footer__links a {
    color: var(--rpgm-text-muted);
  }

  .rpgm-footer__links a:hover,
  .rpgm-footer__links a:focus-visible {
    color: var(--rpgm-accent);
  }

  .rpgm-footer__brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--rpgm-space-2);
    margin-top: var(--rpgm-space-6);
    padding-top: var(--rpgm-space-5);
    border-top: 1px solid var(--rpgm-border);
    text-decoration: none;
    color: var(--rpgm-text-muted);
    transition: color var(--rpgm-transition-fast);
  }

  .rpgm-footer__brand:hover,
  .rpgm-footer__brand:focus-visible {
    color: var(--rpgm-accent);
  }

  .rpgm-footer__brand-logo {
    border-radius: var(--rpgm-radius-sm);
    object-fit: contain;
  }

  .rpgm-footer__brand-copy {
    font-size: var(--rpgm-text-sm);
  }
</style>
