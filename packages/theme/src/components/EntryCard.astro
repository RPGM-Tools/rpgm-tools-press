---
/**
 * Generic list-item card: usable for a blog post list, a release list,
 * or anything else that boils down to (title, date, blurb, tags, link).
 */
interface Props {
  title: string;
  href: string;
  /** Anything Date-parseable, or a pre-formatted string to show as-is. */
  date?: Date | string;
  description?: string;
  tags?: string[];
  class?: string;
  /** Per-repo/product accent color (any CSS color), shown as a thin left-edge stripe. Omit for no stripe. */
  accentColor?: string;
  /** Category label, shown as its own solid-tinted chip ahead of the plain tag chips. */
  category?: string;
  /** Color for the category chip (any CSS color). Falls back to the site accent when a category is given without one. */
  categoryColor?: string;
}

const {
  title,
  href,
  date,
  description,
  tags = [],
  class: className,
  accentColor,
  category,
  categoryColor,
} = Astro.props;

let dateLabel: string | undefined;
if (date instanceof Date) {
  /*
   * Pinned to UTC, not the machine building the site or a fixed local
   * zone: EntryCard's only consumer is the blog, whose `date` is always
   * a date-only frontmatter value ("2026-07-14") - the date-only ISO
   * 8601 spec parses that as midnight UTC of that day, not a real local
   * timestamp, so formatting it back out in UTC recovers exactly the
   * Y-M-D as written on any machine. The system default (or a fixed
   * America/Phoenix, used where an actual timestamped event needs it -
   * see LedgerRow.astro) would instead shift it a day EARLIER, since
   * that midnight-UTC instant is still the previous evening west of UTC.
   */
  dateLabel = date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
    timeZone: "UTC",
  });
} else if (typeof date === "string") {
  dateLabel = date;
}
---

<article
  class:list={["rpgm-entry-card", className]}
  style={accentColor ? `--rpgm-entry-accent: ${accentColor}` : undefined}
>
  <a href={href} class="rpgm-entry-card__link">
    <h3 class="rpgm-entry-card__title">{title}</h3>
    {dateLabel && <p class="rpgm-entry-card__date">{dateLabel}</p>}
    {description && <p class="rpgm-entry-card__description">{description}</p>}
    {
      (category || tags.length > 0) && (
        <ul class="rpgm-entry-card__tags">
          {category && (
            <li
              class="rpgm-entry-card__tags-category"
              style={`--rpgm-entry-category-color: ${categoryColor ?? "var(--rpgm-accent)"}`}
            >
              {category}
            </li>
          )}
          {tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
      )
    }
  </a>
</article>

<style>
  .rpgm-entry-card {
    position: relative;
    /*
     * Clip the stripe (below) to this box's own rounded corners instead of
     * giving the stripe a hand-matched border-radius of its own - two
     * independently-rounded shapes nested a border-width apart never quite
     * lined up, leaving a visible seam right where the hover glow's ring
     * met the stripe's corner.
     */
    overflow: hidden;
    background: var(--rpgm-surface);
    border: 1px solid var(--rpgm-border);
    border-radius: var(--rpgm-radius-lg);
    box-shadow: var(--rpgm-shadow-elevated);
    transition: box-shadow var(--rpgm-transition-glow), border-color var(--rpgm-transition-glow), transform var(--rpgm-transition-fast);
  }

  /*
   * A per-product identity mark, not a mood: a thin stripe on the resting
   * card, not a background tint (which would fight the card's own text
   * contrast and the tags' own coloring). The hover glow below stays the
   * site's one consistent gold, deliberately not recolored per repo - two
   * competing "pick a color" signals on the same element would read as
   * noise, not branding. Box-shadow lives on the card itself, so it's
   * unaffected by this element's overflow:hidden and still hugs the same
   * rounded corners the stripe is clipped to.
   */
  .rpgm-entry-card::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: 4px;
    background: var(--rpgm-entry-accent, transparent);
  }

  .rpgm-entry-card:hover,
  .rpgm-entry-card:focus-within {
    border-color: var(--rpgm-border-strong);
    box-shadow: var(--rpgm-shadow-candle-hover);
    transform: translateY(-2px);
  }

  .rpgm-entry-card__link {
    display: block;
    padding: var(--rpgm-space-5) var(--rpgm-space-5) var(--rpgm-space-5) calc(var(--rpgm-space-5) + 4px);
    text-decoration: none;
    color: inherit;
  }

  .rpgm-entry-card__title {
    margin: 0 0 var(--rpgm-space-1);
    font-size: var(--rpgm-text-xl);
    color: var(--rpgm-text);
  }

  .rpgm-entry-card__date {
    margin: 0 0 var(--rpgm-space-3);
    font-size: var(--rpgm-text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--rpgm-accent);
  }

  .rpgm-entry-card__description {
    margin: 0 0 var(--rpgm-space-3);
    color: var(--rpgm-text-muted);
    font-size: var(--rpgm-text-sm);
    line-height: var(--rpgm-leading-normal);
  }

  .rpgm-entry-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--rpgm-space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rpgm-entry-card__tags li {
    font-size: var(--rpgm-text-xs);
    color: var(--rpgm-text-muted);
    border: 1px solid var(--rpgm-border);
    border-radius: var(--rpgm-radius-full);
    padding: 0.15em 0.7em;
  }

  /*
   * The one category a card belongs to gets a solid-tinted chip in that
   * category's own color, distinct from the neutral-bordered tag chips
   * that follow it - a card's category is a single classification, its
   * tags are open-ended keywords, and the color makes that difference
   * legible at a glance across a whole listing.
   *
   * Text stays the theme's own high-contrast foreground token, not the
   * raw category color: several category colors (graphite, dark red) are
   * themselves dark, and using one as small text directly on a dark card
   * with only a faint tint behind it measured well under WCAG AA. The
   * category color still carries the identity, just via the border and
   * background tint - decorative roles with a 3:1 minimum, not the 4.5:1
   * a foreground text color needs.
   */
  .rpgm-entry-card__tags-category {
    font-size: var(--rpgm-text-xs);
    font-weight: 600;
    color: var(--rpgm-text);
    background: color-mix(in srgb, var(--rpgm-entry-category-color) 16%, transparent);
    border: 1px solid color-mix(in srgb, var(--rpgm-entry-category-color) 55%, transparent);
    border-radius: var(--rpgm-radius-full);
    padding: 0.15em 0.7em;
  }
</style>
