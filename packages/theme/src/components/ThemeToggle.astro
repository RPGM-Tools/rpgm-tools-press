---
/**
 * Light/dark/system theme cycle - the header's own candle IS this control,
 * rather than a separate abstract icon sitting next to an unrelated candle
 * ornament. A lit, flickering candle means dark mode; a snuffed candle with
 * a drifting wisp of smoke means light (no need for a candle when it's
 * daytime); "system" shows the candle half-lit and still, since it isn't
 * committed to either state on its own.
 *
 * Defaults to system (no localStorage entry, no data-theme attribute -
 * base.css's own prefers-color-scheme query resolves that case) until a
 * viewer clicks, at which point the choice is stored and wins over the OS
 * setting from then on. See Layout.astro for the matching pre-paint script
 * that applies a stored choice before first render.
 */
const STORAGE_KEY = "rpgm-theme";

const TITLES = {
  system: "Theme: following your system setting - click to light it",
  dark: "Theme: dark (lit) - click to snuff it out",
  light: "Theme: light (snuffed out) - click to follow your system setting",
};
---

<button
  type="button"
  class="rpgm-theme-toggle"
  data-rpgm-theme-toggle
  aria-label="Toggle color theme"
  title={TITLES.system}
>
  <svg
    class="rpgm-theme-toggle__candle"
    viewBox="0 0 24 32"
    width="20"
    height="20"
    fill="none"
    stroke="currentColor"
    stroke-width="1.4"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path
      class="rpgm-theme-toggle__flame"
      d="M12 3 C13.5 6 15 8.2 15 10.5 C15 12.4 13.7 13.6 12 13.6 C10.3 13.6 9 12.4 9 10.5 C9 8.2 10.5 6 12 3 Z"
      fill="currentColor"
      stroke="none"
    />
    <path
      class="rpgm-theme-toggle__smoke"
      d="M12 10 C10.5 8.4 13.5 7.2 12 5.6 C10.7 4.2 12.8 3.2 12 2"
    />
    <path d="M12 13.6 V16" />
    <rect x="8" y="16" width="8" height="12" rx="1" />
    <path d="M8 20 H16" opacity="0.6" />
    <path d="M6 28 H18" stroke-width="1.2" opacity="0.7" />
  </svg>
</button>

<script define:vars={{ STORAGE_KEY, TITLES }}>
  const ORDER = ["system", "light", "dark"];

  function stored() {
    try {
      const value = localStorage.getItem(STORAGE_KEY);
      return value === "light" || value === "dark" ? value : "system";
    } catch {
      return "system";
    }
  }

  function resolved(theme) {
    if (theme !== "system") return theme;
    return window.matchMedia?.("(prefers-color-scheme: dark)").matches ? "dark" : "light";
  }

  function apply(theme) {
    if (theme === "system") delete document.documentElement.dataset.theme;
    else document.documentElement.dataset.theme = theme;
    document.querySelectorAll("[data-rpgm-theme-toggle]").forEach((btn) => {
      btn.dataset.current = theme;
      btn.title = TITLES[theme];
    });
    // Lets anything that can't just read CSS custom properties (e.g. an
    // embedded third-party widget like giscus) react to a resolved
    // light/dark value without polling.
    document.dispatchEvent(
      new CustomEvent("rpgm-theme-change", { detail: { theme: resolved(theme) } }),
    );
  }

  apply(stored());

  document.querySelectorAll("[data-rpgm-theme-toggle]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const next = ORDER[(ORDER.indexOf(stored()) + 1) % ORDER.length];
      try {
        localStorage.setItem(STORAGE_KEY, next);
      } catch {
        /* localStorage unavailable - theme still applies for this page view, just won't persist */
      }
      apply(next);
    });
  });
</script>

<style>
  .rpgm-theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.1em;
    height: 2.1em;
    background: transparent;
    border: 1px solid var(--rpgm-border);
    border-radius: var(--rpgm-radius-full);
    color: var(--rpgm-text-muted);
    cursor: pointer;
    transition: border-color var(--rpgm-transition-fast), color var(--rpgm-transition-fast), box-shadow var(--rpgm-transition-glow);
  }

  .rpgm-theme-toggle:hover,
  .rpgm-theme-toggle:focus-visible {
    color: var(--rpgm-accent);
    border-color: var(--rpgm-border-strong);
    box-shadow: var(--rpgm-shadow-candle);
  }

  /*
   * Three states, one glyph. "system" (no data-current yet, or explicitly
   * "system") shows a half-committed candle: flame present but dim and
   * static. "dark" lights it fully and lets it flicker (same keyframes as
   * the old standalone CandleIcon). "light" snuffs the flame out and shows
   * a thin wisp of smoke drifting instead - a candle has no job in daylight.
   */
  .rpgm-theme-toggle__flame {
    transform-origin: 12px 8px;
    opacity: 0.55;
    transition: opacity var(--rpgm-transition-glow);
  }

  .rpgm-theme-toggle__smoke {
    opacity: 0;
    stroke-width: 1.1;
    transition: opacity var(--rpgm-transition-glow);
  }

  .rpgm-theme-toggle[data-current="dark"] .rpgm-theme-toggle__flame {
    opacity: 1;
    animation: rpgm-flicker 2.6s ease-in-out infinite;
  }

  .rpgm-theme-toggle[data-current="light"] .rpgm-theme-toggle__flame {
    opacity: 0;
  }

  .rpgm-theme-toggle[data-current="light"] .rpgm-theme-toggle__smoke {
    opacity: 0.7;
    animation: rpgm-smoke-drift 3.2s ease-in-out infinite;
  }

  @keyframes rpgm-flicker {
    0%, 100% { opacity: 1; transform: scale(1) skewX(0deg); }
    25% { opacity: 0.92; transform: scale(1.04, 0.97) skewX(-1deg); }
    50% { opacity: 0.85; transform: scale(0.97, 1.03) skewX(1deg); }
    75% { opacity: 0.96; transform: scale(1.02, 0.99) skewX(-0.5deg); }
  }

  @keyframes rpgm-smoke-drift {
    0% { opacity: 0.7; transform: translateY(0) scaleY(1); }
    50% { opacity: 0.3; transform: translateY(-1.5px) scaleY(1.08); }
    100% { opacity: 0.7; transform: translateY(0) scaleY(1); }
  }
</style>
