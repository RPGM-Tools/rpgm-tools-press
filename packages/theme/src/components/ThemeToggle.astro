---
/**
 * Light/dark/system theme cycle. Defaults to system (no localStorage entry,
 * no data-theme attribute - base.css's own prefers-color-scheme query
 * resolves that case) until a viewer clicks, at which point the choice is
 * stored and wins over the OS setting from then on. See Layout.astro for
 * the matching pre-paint script that applies a stored choice before first
 * render.
 */
const STORAGE_KEY = "rpgm-theme";
---

<button
  type="button"
  class="rpgm-theme-toggle"
  data-rpgm-theme-toggle
  aria-label="Toggle color theme"
>
  <svg data-rpgm-theme-icon="system" viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
    <circle cx="10" cy="10" r="7" />
    <path d="M10 3 A7 7 0 0 1 10 17 Z" fill="currentColor" stroke="none" />
  </svg>
  <svg data-rpgm-theme-icon="light" viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
    <circle cx="10" cy="10" r="4" />
    <path stroke-linecap="round" d="M10 1.5v2M10 16.5v2M18.5 10h-2M3.5 10h-2M15.66 4.34l-1.42 1.42M5.76 14.24l-1.42 1.42M15.66 15.66l-1.42-1.42M5.76 5.76L4.34 4.34" />
  </svg>
  <svg data-rpgm-theme-icon="dark" viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" d="M17 11.2A7 7 0 1 1 8.8 3a5.6 5.6 0 0 0 8.2 8.2Z" />
  </svg>
</button>

<script define:vars={{ STORAGE_KEY }}>
  const ORDER = ["system", "light", "dark"];

  function stored() {
    try {
      const value = localStorage.getItem(STORAGE_KEY);
      return value === "light" || value === "dark" ? value : "system";
    } catch {
      return "system";
    }
  }

  function apply(theme) {
    if (theme === "system") delete document.documentElement.dataset.theme;
    else document.documentElement.dataset.theme = theme;
    document.querySelectorAll("[data-rpgm-theme-toggle]").forEach((btn) => {
      btn.dataset.current = theme;
    });
  }

  apply(stored());

  document.querySelectorAll("[data-rpgm-theme-toggle]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const next = ORDER[(ORDER.indexOf(stored()) + 1) % ORDER.length];
      try {
        localStorage.setItem(STORAGE_KEY, next);
      } catch {
        /* localStorage unavailable - theme still applies for this page view, just won't persist */
      }
      apply(next);
    });
  });
</script>

<style>
  .rpgm-theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.1em;
    height: 2.1em;
    background: transparent;
    border: 1px solid var(--rpgm-border);
    border-radius: var(--rpgm-radius-full);
    color: var(--rpgm-text-muted);
    cursor: pointer;
    transition: border-color var(--rpgm-transition-fast), color var(--rpgm-transition-fast), box-shadow var(--rpgm-transition-glow);
  }

  .rpgm-theme-toggle:hover,
  .rpgm-theme-toggle:focus-visible {
    color: var(--rpgm-accent);
    border-color: var(--rpgm-border-strong);
    box-shadow: var(--rpgm-shadow-candle);
  }

  .rpgm-theme-toggle [data-rpgm-theme-icon] {
    display: none;
  }

  /* Default (no JS yet, or before the click handler's first apply()): show the system icon. */
  .rpgm-theme-toggle [data-rpgm-theme-icon="system"] {
    display: block;
  }

  .rpgm-theme-toggle[data-current="light"] [data-rpgm-theme-icon="system"],
  .rpgm-theme-toggle[data-current="dark"] [data-rpgm-theme-icon="system"] {
    display: none;
  }

  .rpgm-theme-toggle[data-current="light"] [data-rpgm-theme-icon="light"] {
    display: block;
  }

  .rpgm-theme-toggle[data-current="dark"] [data-rpgm-theme-icon="dark"] {
    display: block;
  }
</style>
