---
import Nav, { type NavLink } from "./Nav.astro";
import SealGlyph from "../ornaments/SealGlyph.astro";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  siteTitle: string;
  tagline?: string;
  links: NavLink[];
  /** This site's own logo image. Falls back to the generic SealGlyph ornament when omitted. */
  logoSrc?: string;
}

const { siteTitle, tagline, links, logoSrc } = Astro.props;
---

<header class="rpgm-header">
  <div class="rpgm-header__inner">
    <a href="/" class="rpgm-header__brand">
      {logoSrc ? (
        <img src={logoSrc} alt="" width="30" height="30" class="rpgm-header__seal" />
      ) : (
        <SealGlyph size={30} class="rpgm-header__seal" />
      )}
      <span class="rpgm-header__title-block">
        <span class="rpgm-header__title">{siteTitle}</span>
        {tagline && <span class="rpgm-header__tagline">{tagline}</span>}
      </span>
    </a>
    <div class="rpgm-header__right">
      <Nav links={links} />
      <a href="/#entry-search" class="rpgm-header__search-link" data-rpgm-search-link>
        <svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <circle cx="8.5" cy="8.5" r="6" />
          <path d="M13 13 L18 18" stroke-linecap="round" />
        </svg>
        <span>Search</span>
        <kbd aria-hidden="true">/</kbd>
      </a>
      <ThemeToggle />
    </div>
  </div>
</header>

<script>
  // Sets data-condensed past 64px of scroll and clears it under 8px, so the header can't toggle back and forth at a single threshold.
  const header = document.querySelector<HTMLElement>(".rpgm-header");
  if (header) {
    // Sticky rails and anchor jumps read the header's current height from --rpgm-header-height.
    const publishHeight = () => document.documentElement.style.setProperty("--rpgm-header-height", `${header.offsetHeight}px`);
    let lastY = window.scrollY;
    const update = () => {
      const before = header.offsetHeight;
      const y = window.scrollY;
      if (y > 64) header.dataset.condensed = "";
      else if (y < 8) delete header.dataset.condensed;
      // data-reveal is set when the page moves up more than 4px and cleared when it moves down, so the phone nav row returns on any upward scroll.
      if (y < lastY - 4) header.dataset.reveal = "";
      else if (y > lastY + 4) delete header.dataset.reveal;
      if (Math.abs(y - lastY) > 4) lastY = y;
      if (header.offsetHeight !== before) publishHeight();
    };
    window.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", publishHeight, { passive: true });
    header.addEventListener("transitionend", publishHeight);
    update();
    publishHeight();
  }

  document.querySelectorAll<HTMLAnchorElement>("[data-rpgm-search-link]").forEach((link) => {
    function focusLocalSearch(): boolean {
      const input = document.querySelector<HTMLInputElement>("#entry-search");
      if (!input) return false;
      input.focus();
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      input.scrollIntoView({ behavior: reduceMotion ? "auto" : "smooth", block: "center" });
      return true;
    }

    link.addEventListener("click", (event) => {
      if (focusLocalSearch()) event.preventDefault();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key !== "/" || event.ctrlKey || event.metaKey || event.altKey) return;
      const target = event.target as HTMLElement | null;
      if (target?.tagName === "INPUT" || target?.tagName === "TEXTAREA" || target?.isContentEditable) return;
      event.preventDefault();
      if (!focusLocalSearch()) window.location.assign(link.href);
    });
  });
</script>

<style>
  .rpgm-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--rpgm-bg-elevated);
    border-bottom: 1px solid var(--rpgm-border);
    transition: box-shadow var(--rpgm-transition-fast);
  }

  .rpgm-header[data-condensed] {
    box-shadow: var(--rpgm-shadow-elevated);
  }

  .rpgm-header__inner,
  .rpgm-header__title,
  .rpgm-header__seal {
    transition: padding var(--rpgm-transition-fast), font-size var(--rpgm-transition-fast), width var(--rpgm-transition-fast), height var(--rpgm-transition-fast), color var(--rpgm-transition-fast);
  }

  .rpgm-header[data-condensed] .rpgm-header__inner {
    padding-block: var(--rpgm-space-2);
  }

  .rpgm-header[data-condensed] .rpgm-header__title {
    font-size: var(--rpgm-text-lg);
  }

  .rpgm-header[data-condensed] .rpgm-header__seal {
    width: 22px;
    height: 22px;
  }

  .rpgm-header[data-condensed] .rpgm-header__tagline {
    display: none;
  }

  /* Under 48em the nav wraps to a second row about 80px tall, so a condensed header drops it unless data-reveal is set. */
  @media (max-width: 48em) {
    .rpgm-header[data-condensed]:not([data-reveal]) .rpgm-header__right {
      display: none;
    }
  }

  /* A page with its own search field needs no button that only jumps to it. The / shortcut still works. */
  :global(body:has(#entry-search)) .rpgm-header__search-link {
    display: none;
  }

  .rpgm-header__inner {
    /* Matches .rpgm-main's own 64rem - see Layout.astro's comment. */
    max-width: 64rem;
    margin: 0 auto;
    padding: var(--rpgm-space-5) var(--rpgm-space-5);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--rpgm-space-4);
  }

  .rpgm-header__brand {
    display: flex;
    align-items: center;
    gap: var(--rpgm-space-3);
    text-decoration: none;
    color: var(--rpgm-text);
  }

  .rpgm-header__brand:hover .rpgm-header__seal,
  .rpgm-header__brand:focus-visible .rpgm-header__seal {
    color: var(--rpgm-accent-hover);
  }

  .rpgm-header__seal {
    color: var(--rpgm-accent);
    flex-shrink: 0;
  }

  img.rpgm-header__seal {
    border-radius: var(--rpgm-radius-sm);
    object-fit: contain;
  }

  .rpgm-header__title-block {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .rpgm-header__title {
    font-family: var(--rpgm-font-display);
    font-weight: 700;
    font-size: var(--rpgm-text-xl);
    color: var(--rpgm-text);
  }

  .rpgm-header__tagline {
    font-size: var(--rpgm-text-xs);
    color: var(--rpgm-text-muted);
    letter-spacing: 0.03em;
  }

  .rpgm-header__right {
    display: flex;
    align-items: center;
    gap: var(--rpgm-space-4);
    flex-wrap: wrap;
  }

  .rpgm-header__search-link {
    display: inline-flex;
    align-items: center;
    gap: var(--rpgm-space-2);
    color: var(--rpgm-text-muted);
    border: 1px solid var(--rpgm-border);
    border-radius: var(--rpgm-radius-full);
    padding: 0.4em 0.9em;
    font-size: var(--rpgm-text-sm);
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    transition: border-color var(--rpgm-transition-fast), color var(--rpgm-transition-fast), box-shadow var(--rpgm-transition-glow);
  }

  .rpgm-header__search-link:hover,
  .rpgm-header__search-link:focus-visible {
    color: var(--rpgm-accent);
    border-color: var(--rpgm-border-strong);
    box-shadow: var(--rpgm-shadow-candle);
  }

  .rpgm-header__search-link kbd {
    font-family: var(--rpgm-font-mono);
    font-size: 0.7em;
    color: var(--rpgm-text-muted);
    background: var(--rpgm-bg);
    border: 1px solid var(--rpgm-border);
    border-radius: var(--rpgm-radius-sm);
    padding: 0.15em 0.4em;
  }

  /* Never the one that gets squeezed onto its own line - it's the smallest, most-used control in the row. */
  .rpgm-header__right :global([data-rpgm-theme-toggle]) {
    flex-shrink: 0;
  }
</style>
