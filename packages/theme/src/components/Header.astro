---
import Nav, { type NavLink } from "./Nav.astro";
import SealGlyph from "../ornaments/SealGlyph.astro";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  siteTitle: string;
  tagline?: string;
  links: NavLink[];
  /** This site's own logo image. Falls back to the generic SealGlyph ornament when omitted. */
  logoSrc?: string;
  /** Show a search field. A page's own ListFilter goes in the "search" slot; without one, the field searches from the homepage. */
  search?: boolean;
  /** Whether the page filled the "search" slot. Layout passes this through. */
  hasPageSearch?: boolean;
}

const { siteTitle, tagline, links, logoSrc, search = true, hasPageSearch = false } = Astro.props;
---

<header class="rpgm-header">
  <div class="rpgm-header__inner">
    <a href="/" class="rpgm-header__brand">
      {logoSrc ? (
        <img src={logoSrc} alt="" width="30" height="30" class="rpgm-header__seal" />
      ) : (
        <SealGlyph size={30} class="rpgm-header__seal" />
      )}
      <span class="rpgm-header__title-block">
        <span class="rpgm-header__title">{siteTitle}</span>
        {tagline && <span class="rpgm-header__tagline">{tagline}</span>}
      </span>
    </a>
    <div class="rpgm-header__right">
      <div class="rpgm-header__links"><Nav links={links} /></div>
      {
        search && (
          <div class="rpgm-header__search">
            {hasPageSearch ? (
              <slot name="search" />
            ) : (
              <form action="/" method="get" role="search" class="rpgm-list-filter">
                <svg viewBox="0 0 20 20" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                  <circle cx="8.5" cy="8.5" r="6" />
                  <path d="M13 13 L18 18" stroke-linecap="round" />
                </svg>
                <input id="site-search" type="search" name="q" class="rpgm-list-filter__input" placeholder="Search" aria-label="Search this site" autocomplete="off" spellcheck="false" />
              </form>
            )}
          </div>
        )
      }
      <div class="rpgm-header__toggle"><ThemeToggle /></div>
    </div>
  </div>
</header>

<script>
  // Sets data-condensed past 64px of scroll and clears it under 8px, so the header can't toggle back and forth at a single threshold.
  const header = document.querySelector<HTMLElement>(".rpgm-header");
  if (header) {
    // Sticky rails and anchor jumps read the header's current height from --rpgm-header-height.
    const publishHeight = () => document.documentElement.style.setProperty("--rpgm-header-height", `${header.offsetHeight}px`);
    let lastY = window.scrollY;
    const update = () => {
      const before = header.offsetHeight;
      const y = window.scrollY;
      if (y > 64) header.dataset.condensed = "";
      else if (y < 8) delete header.dataset.condensed;
      // data-reveal is set when the page moves up more than 4px and cleared when it moves down, so the phone nav row returns on any upward scroll.
      if (y < lastY - 4) header.dataset.reveal = "";
      else if (y > lastY + 4) delete header.dataset.reveal;
      if (Math.abs(y - lastY) > 4) lastY = y;
      if (header.offsetHeight !== before) publishHeight();
    };
    window.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", publishHeight, { passive: true });
    header.addEventListener("transitionend", publishHeight);
    update();
    publishHeight();
  }

  // Pressing / anywhere outside a text field focuses the header's search.
  document.addEventListener("keydown", (event) => {
    if (event.key !== "/" || event.ctrlKey || event.metaKey || event.altKey) return;
    const target = event.target as HTMLElement | null;
    if (target?.tagName === "INPUT" || target?.tagName === "TEXTAREA" || target?.isContentEditable) return;
    const input = document.querySelector<HTMLInputElement>(".rpgm-header__search input");
    if (!input) return;
    event.preventDefault();
    input.focus();
  });
</script>

<style>
  .rpgm-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--rpgm-bg-elevated);
    border-bottom: 1px solid var(--rpgm-border);
    transition: box-shadow var(--rpgm-transition-fast);
  }

  .rpgm-header[data-condensed] {
    box-shadow: var(--rpgm-shadow-elevated);
  }

  .rpgm-header__inner,
  .rpgm-header__title,
  .rpgm-header__seal {
    transition: padding var(--rpgm-transition-fast), font-size var(--rpgm-transition-fast), width var(--rpgm-transition-fast), height var(--rpgm-transition-fast), color var(--rpgm-transition-fast);
  }

  .rpgm-header[data-condensed] .rpgm-header__inner {
    padding-block: var(--rpgm-space-2);
  }

  .rpgm-header[data-condensed] .rpgm-header__title {
    font-size: var(--rpgm-text-lg);
  }

  .rpgm-header[data-condensed] .rpgm-header__seal {
    width: 22px;
    height: 22px;
  }

  .rpgm-header[data-condensed] .rpgm-header__tagline {
    display: none;
  }

  /* Under 48em the nav wraps to a second row about 80px tall, so a condensed header drops it and the theme toggle unless data-reveal is set. The search row stays. */
  @media (max-width: 48em) {
    .rpgm-header[data-condensed]:not([data-reveal]) :is(.rpgm-header__links, .rpgm-header__toggle) {
      display: none;
    }

    .rpgm-header .rpgm-header__right {
      flex: 1 1 100%;
    }

    .rpgm-header .rpgm-header__search {
      order: 3;
      flex: 1 1 100%;
    }
  }

  .rpgm-header__inner {
    /* Matches .rpgm-main's own 64rem - see Layout.astro's comment. */
    max-width: 64rem;
    margin: 0 auto;
    padding: var(--rpgm-space-5) var(--rpgm-space-5);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--rpgm-space-4);
  }

  .rpgm-header__brand {
    display: flex;
    align-items: center;
    gap: var(--rpgm-space-3);
    text-decoration: none;
    color: var(--rpgm-text);
  }

  .rpgm-header__brand:hover .rpgm-header__seal,
  .rpgm-header__brand:focus-visible .rpgm-header__seal {
    color: var(--rpgm-accent-hover);
  }

  .rpgm-header__seal {
    color: var(--rpgm-accent);
    flex-shrink: 0;
  }

  img.rpgm-header__seal {
    border-radius: var(--rpgm-radius-sm);
    object-fit: contain;
  }

  .rpgm-header__title-block {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .rpgm-header__title {
    font-family: var(--rpgm-font-display);
    font-weight: 700;
    font-size: var(--rpgm-text-xl);
    color: var(--rpgm-text);
  }

  .rpgm-header__tagline {
    font-size: var(--rpgm-text-xs);
    color: var(--rpgm-text-muted);
    letter-spacing: 0.03em;
  }

  .rpgm-header__right {
    display: flex;
    align-items: center;
    gap: var(--rpgm-space-3);
    flex-wrap: wrap;
  }

  .rpgm-header__search {
    position: relative;
    flex: 0 1 12rem;
    min-width: 10rem;
    color: var(--rpgm-text-muted);
  }

  .rpgm-header__search :global(.rpgm-list-filter) {
    position: relative;
    margin: 0;
  }

  .rpgm-header .rpgm-header__search :global(svg) {
    position: absolute;
    left: var(--rpgm-space-3);
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
  }

  .rpgm-header__search :global(.rpgm-list-filter__input) {
    width: 100%;
    background: var(--rpgm-surface);
    border: 1px solid var(--rpgm-border);
    border-radius: var(--rpgm-radius-full);
    color: var(--rpgm-text);
    font-family: var(--rpgm-font-body);
    font-size: var(--rpgm-text-sm);
    padding: 0.45em 1em 0.45em 2.4em;
    transition: border-color var(--rpgm-transition-fast), box-shadow var(--rpgm-transition-glow);
  }

  .rpgm-header__search :global(.rpgm-list-filter__input::placeholder) {
    color: var(--rpgm-text-muted);
  }

  .rpgm-header__search :global(.rpgm-list-filter__input:focus) {
    outline: none;
    border-color: var(--rpgm-border-strong);
    box-shadow: var(--rpgm-shadow-candle);
  }

  /* The list filter's status shows as a chip under the field, so a search doesn't make the header taller. */
  .rpgm-header__search :global(.rpgm-list-filter__status) {
    position: absolute;
    top: calc(100% + var(--rpgm-space-2));
    right: 0;
    margin: 0;
    padding: 0.3em 0.8em;
    white-space: nowrap;
    font-size: var(--rpgm-text-xs);
    color: var(--rpgm-text);
    background: var(--rpgm-bg-elevated);
    border: 1px solid var(--rpgm-border);
    border-radius: var(--rpgm-radius-full);
    box-shadow: var(--rpgm-shadow-elevated);
  }

  /* Kept for screen readers through aria-describedby, but too long to show in the header. */
  .rpgm-header__search :global(.rpgm-list-filter__hint) {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Never the one that gets squeezed onto its own line - it's the smallest, most-used control in the row. */
  .rpgm-header__toggle {
    flex-shrink: 0;
  }
</style>
