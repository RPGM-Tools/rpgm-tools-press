---
import type { NavLink } from "./Nav.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import "../tokens/base.css";
import "../tokens/typography.css";

export interface Props {
  /** Page <title>. Rendered as "{title} | {siteTitle}" unless it already contains the site title. */
  title: string;
  /** Page meta description. */
  description?: string;
  /** Site name, shown in the header, footer, and title suffix. */
  siteTitle: string;
  /** Short tagline shown under the site title in the header. */
  tagline?: string;
  /** This site's own logo image, passed through to Header. Falls back to the generic SealGlyph ornament when omitted. */
  logoSrc?: string;
  /** Primary nav links, passed through to Header/Nav. */
  navLinks: NavLink[];
  /** Footer links (defaults to navLinks if omitted). */
  footerLinks?: NavLink[];
  /** RSS autodiscovery <link> - set both to enable. Also surfaced as a footer link. */
  rssTitle?: string;
  rssHref?: string;
  /** Link to this site's own source repo, surfaced as a footer link. */
  githubHref?: string;
  /**
   * Cloudflare Web Analytics token. Defaults to the consuming app's own
   * PUBLIC_CF_BEACON_TOKEN env var when omitted, so most pages never need
   * to pass this explicitly. The beacon script only renders when a token
   * ends up set, from either source.
   */
  analyticsToken?: string;
  /** Absolute canonical URL for this page, if known. */
  canonicalURL?: string | URL;
}

const {
  title,
  description,
  siteTitle,
  tagline,
  logoSrc,
  navLinks,
  footerLinks,
  rssTitle,
  rssHref,
  githubHref,
  analyticsToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN,
  canonicalURL,
} = Astro.props;

const pageTitle = title.includes(siteTitle) ? title : `${title} | ${siteTitle}`;
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline>
      // Runs before any stylesheet paints, so an explicit past choice
      // (ThemeToggle, stored in localStorage) applies with no flash of
      // the other theme. No stored choice at all is left as-is here -
      // base.css's own prefers-color-scheme media query resolves that
      // case, which is what makes "default to system" hold for a
      // first-time visitor who has never touched the toggle.
      (function () {
        try {
          var stored = localStorage.getItem("rpgm-theme");
          if (stored === "light" || stored === "dark") {
            document.documentElement.dataset.theme = stored;
          }
        } catch (e) {
          /* localStorage unavailable (private mode, disabled storage) - fall through to system default */
        }
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    {canonicalURL && <link rel="canonical" href={canonicalURL.toString()} />}

    <!-- Open Graph / social -->
    <meta property="og:title" content={pageTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteTitle} />

    <!-- RSS autodiscovery -->
    {
      rssTitle && rssHref && (
        <link rel="alternate" type="application/rss+xml" title={rssTitle} href={rssHref} />
      )
    }

    <!-- Per-page head extras (fonts, additional meta, structured data, etc). -->
    <slot name="head" />

    <!--
      Cloudflare Web Analytics. Only rendered when an analyticsToken is
      supplied - no token means no beacon, no third-party request.
    -->
    {
      analyticsToken && (
        <script
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: analyticsToken })}
        />
      )
    }
  </head>
  <body>
    <Header siteTitle={siteTitle} tagline={tagline} logoSrc={logoSrc} links={navLinks} />
    <main class="rpgm-main" data-pagefind-body>
      <slot />
    </main>
    <Footer
      siteTitle={siteTitle}
      links={footerLinks ?? navLinks}
      rssHref={rssHref}
      githubHref={githubHref}
    />
  </body>
</html>

<style is:global>
  .rpgm-main {
    max-width: 76rem;
    margin: 0 auto;
    padding: var(--rpgm-space-7) var(--rpgm-space-5);
    min-height: 40vh;
  }
</style>
