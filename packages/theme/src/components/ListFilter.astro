---
/**
 * A live text filter for an entry listing - as-you-type, no page reload, no
 * separate results panel. Distinct from SearchTrigger/Pagefind: Pagefind is
 * a full-text index of the WHOLE built site, opened in its own panel;
 * this is a plain substring match scoped to the entries already rendered on
 * THIS page, hiding non-matching <li> children in place as you type. Use it
 * above a listing (post-list, ledger-register, etc.) where "just narrow
 * down what's already on screen" is the ask, not "search everything ever
 * published."
 *
 * targetSelector is resolved with querySelectorAll against the whole
 * document (not just this component's own markup - Astro scoping wouldn't
 * reach the list anyway), so it can match more than one list on a page (the
 * archive page has one <ul class="post-list"> per year).
 */
interface Props {
  targetSelector: string;
  placeholder?: string;
}

const { targetSelector, placeholder = "Filter these entries..." } = Astro.props;
---

<div class="rpgm-list-filter">
  <svg viewBox="0 0 20 20" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
    <circle cx="8.5" cy="8.5" r="6" />
    <path d="M13 13 L18 18" stroke-linecap="round" />
  </svg>
  <input
    type="search"
    class="rpgm-list-filter__input"
    data-rpgm-list-filter={targetSelector}
    placeholder={placeholder}
    aria-label={placeholder}
  />
  <p class="rpgm-list-filter__empty" hidden>Nothing matches "<span></span>".</p>
</div>

<script>
  document.querySelectorAll<HTMLInputElement>("[data-rpgm-list-filter]").forEach((input) => {
    const selector = input.dataset.rpgmListFilter;
    if (!selector) return;

    const lists = Array.from(document.querySelectorAll<HTMLElement>(selector));
    if (lists.length === 0) return;

    const empty = input.closest(".rpgm-list-filter")?.querySelector<HTMLElement>(".rpgm-list-filter__empty");
    const emptyTerm = empty?.querySelector("span");

    input.addEventListener("input", () => {
      const term = input.value.trim().toLowerCase();
      let totalVisible = 0;

      for (const list of lists) {
        let visibleInList = 0;
        for (const item of Array.from(list.children) as HTMLElement[]) {
          const match = term.length === 0 || (item.textContent ?? "").toLowerCase().includes(term);
          item.hidden = !match;
          if (match) visibleInList += 1;
        }
        totalVisible += visibleInList;

        // The archive page groups lists inside a per-year <section> - hide
        // the whole section (its heading included) once a filter empties it
        // out, rather than leaving a bare "2026" heading over nothing.
        const section = list.closest("section");
        if (section) section.hidden = term.length > 0 && visibleInList === 0;
      }

      if (empty) {
        empty.hidden = term.length === 0 || totalVisible > 0;
        if (emptyTerm) emptyTerm.textContent = input.value.trim();
      }
    });
  });
</script>

<style>
  .rpgm-list-filter {
    position: relative;
    margin: var(--rpgm-space-5) 0 0;
    color: var(--rpgm-text-muted);
  }

  .rpgm-list-filter svg {
    position: absolute;
    left: var(--rpgm-space-3);
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
  }

  .rpgm-list-filter__input {
    width: 100%;
    background: var(--rpgm-surface);
    border: 1px solid var(--rpgm-border);
    border-radius: var(--rpgm-radius-full);
    color: var(--rpgm-text);
    font-family: var(--rpgm-font-body);
    font-size: var(--rpgm-text-sm);
    padding: 0.55em 1em 0.55em 2.4em;
    transition: border-color var(--rpgm-transition-fast), box-shadow var(--rpgm-transition-glow);
  }

  .rpgm-list-filter__input::placeholder {
    color: var(--rpgm-text-muted);
  }

  .rpgm-list-filter__input:focus,
  .rpgm-list-filter__input:focus-visible {
    outline: none;
    border-color: var(--rpgm-border-strong);
    box-shadow: var(--rpgm-shadow-candle);
  }

  /* Kill the native browser "clear" and "search" decorations so this reads as
     the theme's own control, not an unstyled OS widget. */
  .rpgm-list-filter__input::-webkit-search-decoration,
  .rpgm-list-filter__input::-webkit-search-cancel-button {
    -webkit-appearance: none;
  }

  .rpgm-list-filter__empty {
    margin: var(--rpgm-space-4) 0 0;
    font-size: var(--rpgm-text-sm);
    color: var(--rpgm-text-muted);
  }
</style>
