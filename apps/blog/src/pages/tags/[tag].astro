---
import { getCollection } from "astro:content";
import Layout from "@rpgm/tools-press-theme/components/Layout.astro";
import EntryCard from "@rpgm/tools-press-theme/components/EntryCard.astro";
import ListFilter from "@rpgm/tools-press-theme/components/ListFilter.astro";
import SiteHead from "../../components/SiteHead.astro";
import { SITE_TITLE, SITE_LOGO, NAV_LINKS, CATEGORY_META, REPO_URL } from "../../consts";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  const tags = new Set<string>();
  for (const post of posts) {
    for (const tag of post.data.tags) tags.add(tag);
  }

  return Array.from(tags).map((tag) => {
    const filtered = posts
      .filter((post) => post.data.tags.includes(tag))
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
    return { params: { tag }, props: { tag, posts: filtered } };
  });
}

const { tag, posts } = Astro.props;
---

<Layout
  title={`Posts tagged "${tag}"`}
  description={`All posts tagged "${tag}" on ${SITE_TITLE}.`}
  siteTitle={SITE_TITLE}
  logoSrc={SITE_LOGO}
  navLinks={NAV_LINKS}
  rssTitle={SITE_TITLE}
  rssHref="/rss.xml"
  githubHref={REPO_URL}
>
  <Fragment slot="head">
    <SiteHead />
  </Fragment>

  <p class="rpgm-eyebrow">Tag</p>
  <h1>{tag}</h1>
  <ListFilter targetSelector=".post-list" placeholder="Search the full text of these entries..." />

  <ul class="post-list">
    {
      posts.map((post) => (
        <li>
          <EntryCard
            title={post.data.title}
            href={`/posts/${post.id}/`}
            date={post.data.pubDate}
            description={post.data.description}
            tags={post.data.tags}
            category={post.data.category && CATEGORY_META[post.data.category]?.label}
            categoryColor={post.data.category && CATEGORY_META[post.data.category]?.color}
          />
        </li>
      ))
    }
  </ul>
</Layout>

<style>
  .post-list {
    list-style: none;
    margin: var(--rpgm-space-6) 0 0;
    padding: 0;
    display: grid;
    gap: var(--rpgm-space-5);
  }
</style>
