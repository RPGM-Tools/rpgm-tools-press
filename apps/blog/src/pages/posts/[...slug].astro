---
import { getCollection, render } from "astro:content";
import Layout from "@rpgm/tools-press-theme/components/Layout.astro";
import Prose from "@rpgm/tools-press-theme/components/Prose.astro";
import Giscus from "@rpgm/tools-press-theme/components/Giscus.astro";
import Flourish from "@rpgm/tools-press-theme/ornaments/Flourish.astro";
import { transitionName } from "@rpgm/tools-press-theme/transition-name";
import SiteHead from "../../components/SiteHead.astro";
import {
  SITE_TITLE,
  SITE_LOGO,
  AUTHOR_NAME,
  AUTHOR_AVATAR,
  NAV_LINKS,
  GISCUS,
  CATEGORY_META,
  REPO_URL,
  AUTHOR_GITHUB,
  RPGM_TOOLS_URL,
} from "../../consts";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
// Posts with three or more h2 sections get a contents rail in the left margin.
const contents = headings.filter((h) => h.depth === 2);
const showContents = contents.length >= 3;

/*
 * Pinned to UTC, not a fixed local zone like the release date labels
 * elsewhere in this repo - pubDate is a date-only frontmatter value
 * ("2026-07-14"), which the date-only ISO 8601 spec parses as midnight
 * UTC of that day, not a real local timestamp. Formatting it back out in
 * UTC recovers exactly the Y-M-D as written, on any machine; formatting
 * it in America/Phoenix (UTC-7) would shift it a day EARLIER instead,
 * since that midnight-UTC instant is still the previous evening there.
 */
const dateLabel = post.data.pubDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});

const categoryMeta = post.data.category
  ? (CATEGORY_META[post.data.category] ?? {
      label: post.data.category.replace(/-/g, " ").replace(/\b\w/g, (c) => c.toUpperCase()),
      color: "#6b5b3e",
    })
  : undefined;

const site = Astro.site!;
const pageURL = new URL(Astro.url.pathname, site).toString();
const imageURL = new URL(post.data.cover ?? SITE_LOGO, site).toString();
// Structured data for search engines and AI answer engines: who wrote it,
// when, and what it's about.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  mainEntityOfPage: pageURL,
  url: pageURL,
  image: imageURL,
  keywords: post.data.tags.join(", "),
  articleSection: categoryMeta?.label,
  author: {
    "@type": "Person",
    name: AUTHOR_NAME,
    url: new URL("/about/", site).toString(),
    sameAs: [AUTHOR_GITHUB, RPGM_TOOLS_URL],
  },
  publisher: {
    "@type": "Organization",
    name: "RPGM Tools, LLC",
    url: RPGM_TOOLS_URL,
    logo: { "@type": "ImageObject", url: new URL(SITE_LOGO, site).toString() },
  },
};
---

<Layout
  title={post.data.title}
  description={post.data.description}
  siteTitle={SITE_TITLE}
  logoSrc={SITE_LOGO}
  navLinks={NAV_LINKS}
  rssTitle={SITE_TITLE}
  rssHref="/rss.xml"
  githubHref={REPO_URL}
  ogType="article"
  ogImage={post.data.cover}
  ogImageAlt={post.data.cover ? post.data.coverAlt : undefined}
>
  <Fragment slot="head">
    <SiteHead />
    <meta property="article:published_time" content={post.data.pubDate.toISOString()} />
    <meta property="article:author" content={AUTHOR_NAME} />
    {post.data.tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <article class="post-article">
    {
      showContents && (
        <nav class="post-contents" aria-label="Contents">
          <p class="post-contents__label">Contents</p>
          <ol>
            {contents.map((h) => (
              <li>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }
    <p class="rpgm-eyebrow">{dateLabel}</p>
    <h1 style={`view-transition-name: ${transitionName(post.id)}`}>{post.data.title}</h1>
    <p class="post-byline">
      <img src={AUTHOR_AVATAR} alt="" width="32" height="32" class="post-byline__avatar" />
      {AUTHOR_NAME}
    </p>
    {
      (post.data.category || post.data.tags.length > 0) && (
        <ul class="post-tags">
          {categoryMeta && (
            <li
              class="post-tags__category"
              style={`--rpgm-entry-category-color: ${categoryMeta.color}`}
              data-pagefind-filter="category"
            >
              {categoryMeta.label}
            </li>
          )}
          {post.data.tags.map((tag) => (
            <li>
              <a href={`/tags/${tag}/`} data-pagefind-filter="tag">
                {tag}
              </a>
            </li>
          ))}
        </ul>
      )
    }
    {post.data.cover && <img class="post-cover" src={post.data.cover} alt={post.data.coverAlt ?? ""} width="1200" height="630" />}
    <Flourish size={16} color="var(--rpgm-border-strong)" />
    <Prose>
      <Content />
    </Prose>
  </article>

  <script>
    // Sets aria-current on the rail link whose heading is in the top 30 percent of the viewport.
    const links = new Map(
      Array.from(document.querySelectorAll<HTMLAnchorElement>(".post-contents a")).map((a) => [a.hash.slice(1), a]),
    );
    if (links.size > 0) {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            for (const a of links.values()) a.removeAttribute("aria-current");
            links.get(entry.target.id)?.setAttribute("aria-current", "true");
          }
        },
        { rootMargin: "0px 0px -70% 0px" },
      );
      for (const id of links.keys()) {
        const heading = document.getElementById(id);
        if (heading) observer.observe(heading);
      }
    }
  </script>

  {GISCUS.ready && (
    <Giscus
      repo={GISCUS.repo}
      repoId={GISCUS.repoId}
      category={GISCUS.category}
      categoryId={GISCUS.categoryId}
      mapping="pathname"
    />
  )}
</Layout>

<style>
  /*
   * The Flourish above the body already centers itself (see Flourish.astro),
   * but the eyebrow/title/byline/tags and the Prose body below it were each
   * left/full-width at the page's own shell width - only the ornament
   * lined up with the reading column, not the words around it. Constraining
   * the whole article (not just Prose) to the same 42rem gives one
   * consistent centered column, matching how most blogs set post text.
   */
  .post-article {
    position: relative;
    max-width: 42rem;
    margin: 0 auto;
  }

  /* Hidden below 76em, where the margin beside the 42rem column is too narrow for a 10rem rail. */
  .post-contents {
    display: none;
  }

  @media (min-width: 76em) {
    .post-contents {
      display: block;
      position: absolute;
      top: 0;
      bottom: 0;
      right: calc(100% + var(--rpgm-space-6));
      width: 10rem;
    }

    .post-contents__label,
    .post-contents ol {
      position: sticky;
      top: var(--rpgm-space-5);
    }

    .post-contents__label {
      margin: 0 0 var(--rpgm-space-2);
      font-family: var(--rpgm-font-mono);
      font-size: var(--rpgm-text-xs);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--rpgm-text-muted);
    }

    .post-contents ol {
      top: calc(var(--rpgm-space-5) + 1.75rem);
      list-style: none;
      margin: 0;
      padding: 0 0 0 var(--rpgm-space-3);
      border-left: 1px solid var(--rpgm-border);
      display: grid;
      gap: var(--rpgm-space-2);
    }

    .post-contents a {
      font-size: var(--rpgm-text-sm);
      line-height: 1.35;
      color: var(--rpgm-text-muted);
      text-decoration: none;
    }

    .post-contents a:hover,
    .post-contents a:focus-visible,
    .post-contents a[aria-current="true"] {
      color: var(--rpgm-accent);
    }
  }

  .post-cover {
    width: 100%;
    height: auto;
    aspect-ratio: 1200 / 630;
    object-fit: cover;
    border-radius: 8px;
    margin: 0 0 var(--rpgm-space-4);
  }

  .post-byline {
    display: flex;
    align-items: center;
    gap: var(--rpgm-space-2);
    margin: 0 0 var(--rpgm-space-4);
    color: var(--rpgm-text-muted);
    font-size: var(--rpgm-text-sm);
  }

  .post-byline__avatar {
    border-radius: var(--rpgm-radius-full);
    object-fit: cover;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--rpgm-space-2);
    list-style: none;
    margin: 0 0 var(--rpgm-space-4);
    padding: 0;
  }

  .post-tags a {
    font-size: var(--rpgm-text-xs);
    color: var(--rpgm-text-muted);
    border: 1px solid var(--rpgm-border);
    border-radius: var(--rpgm-radius-full);
    padding: 0.15em 0.7em;
    text-decoration: none;
  }

  .post-tags a:hover,
  .post-tags a:focus-visible {
    color: var(--rpgm-accent);
    border-color: var(--rpgm-border-strong);
  }

  .post-tags__category {
    font-size: var(--rpgm-text-xs);
    font-weight: 600;
    color: var(--rpgm-text);
    background: color-mix(in srgb, var(--rpgm-entry-category-color) 16%, transparent);
    border: 1px solid color-mix(in srgb, var(--rpgm-entry-category-color) 55%, transparent);
    border-radius: var(--rpgm-radius-full);
    padding: 0.15em 0.7em;
  }
</style>
