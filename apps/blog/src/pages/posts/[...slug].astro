---
import { getCollection, render } from "astro:content";
import Layout from "@rpgm/tools-press-theme/components/Layout.astro";
import Prose from "@rpgm/tools-press-theme/components/Prose.astro";
import Giscus from "@rpgm/tools-press-theme/components/Giscus.astro";
import Flourish from "@rpgm/tools-press-theme/ornaments/Flourish.astro";
import SiteHead from "../../components/SiteHead.astro";
import {
  SITE_TITLE,
  SITE_LOGO,
  AUTHOR_NAME,
  AUTHOR_AVATAR,
  NAV_LINKS,
  GISCUS,
  CATEGORY_META,
  REPO_URL,
} from "../../consts";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

/*
 * Pinned to UTC, not a fixed local zone like the release date labels
 * elsewhere in this repo - pubDate is a date-only frontmatter value
 * ("2026-07-14"), which the date-only ISO 8601 spec parses as midnight
 * UTC of that day, not a real local timestamp. Formatting it back out in
 * UTC recovers exactly the Y-M-D as written, on any machine; formatting
 * it in America/Phoenix (UTC-7) would shift it a day EARLIER instead,
 * since that midnight-UTC instant is still the previous evening there.
 */
const dateLabel = post.data.pubDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});

const categoryMeta = post.data.category ? CATEGORY_META[post.data.category] : undefined;
---

<Layout
  title={post.data.title}
  description={post.data.description}
  siteTitle={SITE_TITLE}
  logoSrc={SITE_LOGO}
  navLinks={NAV_LINKS}
  rssTitle={SITE_TITLE}
  rssHref="/rss.xml"
  githubHref={REPO_URL}
>
  <Fragment slot="head">
    <SiteHead />
  </Fragment>

  <article class="post-article">
    <p class="rpgm-eyebrow">{dateLabel}</p>
    <h1>{post.data.title}</h1>
    <p class="post-byline">
      <img src={AUTHOR_AVATAR} alt="" width="32" height="32" class="post-byline__avatar" />
      {AUTHOR_NAME}
    </p>
    {
      (post.data.category || post.data.tags.length > 0) && (
        <ul class="post-tags">
          {categoryMeta && (
            <li
              class="post-tags__category"
              style={`--rpgm-entry-category-color: ${categoryMeta.color}`}
              data-pagefind-filter="category"
            >
              {categoryMeta.label}
            </li>
          )}
          {post.data.tags.map((tag) => (
            <li>
              <a href={`/tags/${tag}/`} data-pagefind-filter="tag">
                {tag}
              </a>
            </li>
          ))}
        </ul>
      )
    }
    <Flourish size={16} color="var(--rpgm-border-strong)" />
    <Prose>
      <Content />
    </Prose>
  </article>

  {GISCUS.ready && (
    <Giscus
      repo={GISCUS.repo}
      repoId={GISCUS.repoId}
      category={GISCUS.category}
      categoryId={GISCUS.categoryId}
      mapping="pathname"
    />
  )}
</Layout>

<style>
  /*
   * The Flourish above the body already centers itself (see Flourish.astro),
   * but the eyebrow/title/byline/tags and the Prose body below it were each
   * left/full-width at the page's own 76rem column - only the ornament
   * lined up with the reading column, not the words around it. Constraining
   * the whole article (not just Prose) to the same 42rem gives one
   * consistent centered column, matching how most blogs set post text.
   */
  .post-article {
    max-width: 42rem;
    margin: 0 auto;
  }

  .post-byline {
    display: flex;
    align-items: center;
    gap: var(--rpgm-space-2);
    margin: 0 0 var(--rpgm-space-4);
    color: var(--rpgm-text-muted);
    font-size: var(--rpgm-text-sm);
  }

  .post-byline__avatar {
    border-radius: var(--rpgm-radius-full);
    object-fit: cover;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--rpgm-space-2);
    list-style: none;
    margin: 0 0 var(--rpgm-space-4);
    padding: 0;
  }

  .post-tags a {
    font-size: var(--rpgm-text-xs);
    color: var(--rpgm-text-muted);
    border: 1px solid var(--rpgm-border);
    border-radius: var(--rpgm-radius-full);
    padding: 0.15em 0.7em;
    text-decoration: none;
  }

  .post-tags a:hover,
  .post-tags a:focus-visible {
    color: var(--rpgm-accent);
    border-color: var(--rpgm-border-strong);
  }

  .post-tags__category {
    font-size: var(--rpgm-text-xs);
    font-weight: 600;
    color: var(--rpgm-text);
    background: color-mix(in srgb, var(--rpgm-entry-category-color) 16%, transparent);
    border: 1px solid color-mix(in srgb, var(--rpgm-entry-category-color) 55%, transparent);
    border-radius: var(--rpgm-radius-full);
    padding: 0.15em 0.7em;
  }
</style>
