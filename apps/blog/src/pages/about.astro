---
import Layout from "@rpgm/tools-press-theme/components/Layout.astro";
import Prose from "@rpgm/tools-press-theme/components/Prose.astro";
import Flourish from "@rpgm/tools-press-theme/ornaments/Flourish.astro";
import SiteHead from "../components/SiteHead.astro";
import {
  SITE_TITLE,
  SITE_LOGO,
  NAV_LINKS,
  AUTHOR_NAME,
  AUTHOR_AVATAR,
  AUTHOR_GITHUB,
  RPGM_TOOLS_URL,
  REPO_URL,
} from "../consts";
---

<Layout
  title="About"
  description={`About ${AUTHOR_NAME}, the person behind ${SITE_TITLE}.`}
  siteTitle={SITE_TITLE}
  logoSrc={SITE_LOGO}
  navLinks={NAV_LINKS}
  rssTitle={SITE_TITLE}
  rssHref="/rss.xml"
  githubHref={REPO_URL}
>
  <Fragment slot="head">
    <SiteHead />
  </Fragment>

  <div class="about-article">
    <p class="rpgm-eyebrow">About</p>
    <div class="about-header">
      <img src={AUTHOR_AVATAR} alt={AUTHOR_NAME} width="96" height="96" class="about-header__avatar" />
      <h1>{AUTHOR_NAME}</h1>
    </div>
    <Flourish size={16} color="var(--rpgm-border-strong)" />

    <Prose>
      <p>
        By day, I lead a marketing data and analytics organization, and teach
        as an adjunct professor - mostly technology, analytics, and business
        courses.
      </p>
      <p>
        I studied information technology for my bachelor's degree, then later
        went back for an MBA and a master's in business analytics.
      </p>
      <p>
        In my free time, I build <a href={RPGM_TOOLS_URL}>RPGM Tools</a>,
        working alongside AI as my day-to-day coding partner. <em>Relics
        &amp; Reckonings</em> is where that work shows up as it happens.
      </p>

      <div class="company-header">
        <img src="/rpgm-tools-logo.webp" alt="" width="40" height="40" class="company-header__logo" />
        <h2>RPGM Tools, LLC</h2>
      </div>
      <p>
        RPGM Tools, LLC is the company I'm building around this work: I'm the
        principal and co-founder, and the goal is to grow it from a personal
        project into a real, sustainable business. Neo Angband, a roguelike
        with real roots going back to 1990, is the most complete product it
        has shipped so far and the proving ground for the rest of what the
        company is building. This blog is where that build happens in the
        open.
      </p>

      <p>
        Elsewhere: <a href={AUTHOR_GITHUB}>GitHub</a>.
      </p>
    </Prose>
  </div>
</Layout>

<style>
  .about-article {
    max-width: 42rem;
    margin: 0 auto;
  }

  .about-header {
    display: flex;
    align-items: center;
    gap: var(--rpgm-space-4);
    margin-bottom: var(--rpgm-space-4);
  }

  .about-header h1 {
    margin: 0;
  }

  .about-header__avatar {
    border-radius: var(--rpgm-radius-full);
    object-fit: cover;
    border: 1px solid var(--rpgm-border-strong);
    flex-shrink: 0;
  }

  .company-header {
    display: flex;
    align-items: center;
    gap: var(--rpgm-space-3);
    /* The 2.5em heading top-margin from tokens/typography.css's `.rpgm-prose
       h2` rule moves here instead of staying on the h2 itself - on the h2
       alone it would push the text down relative to the logo beside it,
       since the logo carries no such margin. */
    margin-top: 2.5em;
  }

  .about-article .company-header :global(h2) {
    margin-top: 0;
  }

  .company-header__logo {
    border-radius: var(--rpgm-radius-sm);
    object-fit: contain;
    flex-shrink: 0;
  }
</style>
