---
import { getCollection } from "astro:content";
import Layout from "@rpgm/tools-press-theme/components/Layout.astro";
import EntryCard from "@rpgm/tools-press-theme/components/EntryCard.astro";
import ListFilter from "@rpgm/tools-press-theme/components/ListFilter.astro";
import Flourish from "@rpgm/tools-press-theme/ornaments/Flourish.astro";
import SiteHead from "../components/SiteHead.astro";
import { SITE_TITLE, SITE_TAGLINE, SITE_DESCRIPTION, SITE_LOGO, NAV_LINKS, CATEGORY_META, REPO_URL } from "../consts";

const allPosts = await getCollection("posts", ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout
  title="Home"
  description={SITE_DESCRIPTION}
  siteTitle={SITE_TITLE}
  logoSrc={SITE_LOGO}
  tagline={SITE_TAGLINE}
  navLinks={NAV_LINKS}
  rssTitle={SITE_TITLE}
  rssHref="/rss.xml"
  githubHref={REPO_URL}
>
  <Fragment slot="head">
    <SiteHead />
  </Fragment>

  <p class="rpgm-eyebrow">Latest entries</p>
  <Flourish size={16} color="var(--rpgm-border-strong)" />
  <ListFilter targetSelector=".post-list" placeholder="Search every entry, including its full text..." />

  <ul class="post-list">
    {
      posts.map((post, i) => (
        <li class:list={{ "post-list__latest": i === 0 }}>
          <EntryCard
            title={post.data.title}
            href={`/posts/${post.id}/`}
            date={post.data.pubDate}
            description={post.data.description}
            tags={post.data.tags}
            category={post.data.category && CATEGORY_META[post.data.category]?.label}
            categoryColor={post.data.category && CATEGORY_META[post.data.category]?.color}
            transitionId={post.id}
          />
        </li>
      ))
    }
  </ul>
</Layout>

<style>
  .post-list {
    list-style: none;
    margin: var(--rpgm-space-6) 0 0;
    padding: 0;
    display: grid;
    gap: var(--rpgm-space-5);
  }

  /* The first card is the newest post. It gets a bigger title and a gold top border, and it stays inside .post-list so ListFilter still searches it. */
  .post-list__latest :global(.rpgm-entry-card) {
    border-color: var(--rpgm-border-strong);
    border-top: 3px solid var(--rpgm-accent);
  }

  .post-list__latest :global(.rpgm-entry-card__title) {
    font-size: var(--rpgm-text-2xl, 1.75rem);
  }

  .post-list__latest :global(.rpgm-entry-card__description) {
    font-size: var(--rpgm-text-lg, 1.125rem);
  }
</style>
