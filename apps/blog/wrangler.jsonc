{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rpgm-press-blog",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "bb37de82a8d1040e9945ead5a03bab8d",
  "secrets": {
    "required": ["PRESS_SEARCH_ACCESS_ID", "PRESS_SEARCH_ACCESS_SECRET", "COGITATOR_EMBED_KEY"]
  },
  "kv_namespaces": [
    {
      "binding": "SEARCH_EMBEDDING_CACHE",
      "id": "a22f524658a24ab1a15a3f9fad9f9c7f"
    }
  ],
  "ratelimits": [
    {
      "name": "SEARCH_EMBEDDING_RATE_LIMITER",
      "namespace_id": "10001",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/search-embedding"]
  },
  "routes": [
    {
      "pattern": "blog.rpgm.tools",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
