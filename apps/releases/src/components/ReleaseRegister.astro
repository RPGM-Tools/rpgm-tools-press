---
import type { CollectionEntry } from "astro:content";
import LedgerRow from "@rpgm/tools-press-theme/components/LedgerRow.astro";
import { summarize } from "../lib/summarize";

interface Props {
  /** Already sorted newest first. */
  releases: CollectionEntry<"releases">[];
}

const { releases } = Astro.props;

// Grouped by month for the date rail. Pinned to the same zone as LedgerRow's dates.
const months: { label: string; releases: CollectionEntry<"releases">[] }[] = [];
for (const release of releases) {
  const label = release.data.publishedAt.toLocaleDateString("en-US", { year: "numeric", month: "long", timeZone: "America/Phoenix" });
  if (months.at(-1)?.label !== label) months.push({ label, releases: [] });
  months.at(-1)!.releases.push(release);
}
---

{
  months.map((month) => (
    <section class="ledger-month" aria-label={month.label}>
      <h2 class="ledger-month__label">{month.label}</h2>
      <div class="ledger-register">
        {month.releases.map((release) => (
          <LedgerRow
            title={`${release.data.repoDisplayName} ${release.data.version}`}
            href={`/releases/${release.id}/`}
            date={release.data.publishedAt}
            description={summarize(release.data.summary ?? release.body, 130)}
            accentColor={release.data.color}
            emoji={release.data.emoji}
            transitionId={release.id}
          />
        ))}
      </div>
    </section>
  ))
}

<style>
  /* display: grid below would otherwise beat [hidden] when a search empties the month. */
  .ledger-month[hidden] {
    display: none;
  }

  .ledger-month + .ledger-month {
    margin-top: var(--rpgm-space-6);
  }

  .ledger-month__label {
    margin: 0 0 var(--rpgm-space-2);
    font-family: var(--rpgm-font-mono);
    font-size: var(--rpgm-text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--rpgm-text-muted);
  }

  /* On wide screens the month labels sit in a rail beside the register and stay in view while its rows scroll past. */
  @media (min-width: 60em) {
    .ledger-month {
      display: grid;
      grid-template-columns: 8rem 1fr;
      gap: var(--rpgm-space-4);
      align-items: start;
    }

    .ledger-month__label {
      position: sticky;
      top: calc(var(--rpgm-header-height, 0px) + var(--rpgm-space-4));
      margin: var(--rpgm-space-3) 0 0;
      text-align: right;
    }
  }
</style>
