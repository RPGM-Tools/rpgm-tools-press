---
import { getCollection } from "astro:content";
import Layout from "@rpgm/tools-press-theme/components/Layout.astro";
import LedgerRow from "@rpgm/tools-press-theme/components/LedgerRow.astro";
import Flourish from "@rpgm/tools-press-theme/ornaments/Flourish.astro";
import SiteHead from "../components/SiteHead.astro";
import { SITE_TITLE, SITE_TAGLINE, SITE_DESCRIPTION, SITE_LOGO, NAV_LINKS, REPO_URL } from "../consts";
import { summarize } from "../lib/summarize";
import repos from "../../repos.json";

const allReleases = await getCollection("releases");
const releases = allReleases.sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf() || a.id.localeCompare(b.id),
);

// Pinned to a fixed zone - see EntryCard.astro's identical comment for why.
const syncedAt = new Date().toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "America/Phoenix",
});
---

<Layout
  title="Home"
  description={SITE_DESCRIPTION}
  siteTitle={SITE_TITLE}
  logoSrc={SITE_LOGO}
  tagline={SITE_TAGLINE}
  navLinks={NAV_LINKS}
  rssTitle={SITE_TITLE}
  rssHref="/rss.xml"
  githubHref={REPO_URL}
>
  <Fragment slot="head">
    <SiteHead />
  </Fragment>

  <p class="rpgm-eyebrow">Latest releases</p>
  <Flourish size={16} color="var(--rpgm-border-strong)" />
  <p class="ledger-receipt">
    {releases.length} entries across {repos.length} repositories - last synchronized {syncedAt}.
  </p>

  <div class="ledger-register">
    {
      releases.map((release) => (
        <LedgerRow
          title={`${release.data.repoDisplayName} ${release.data.version}`}
          href={`/releases/${release.id}/`}
          date={release.data.publishedAt}
          description={release.data.summary ?? summarize(release.body)}
          accentColor={release.data.color}
          emoji={release.data.emoji}
        />
      ))
    }
  </div>
</Layout>

<style>
  .ledger-receipt {
    margin: 0 0 var(--rpgm-space-5);
    font-family: var(--rpgm-font-mono);
    font-size: var(--rpgm-text-xs);
    color: var(--rpgm-text-muted);
    text-align: center;
  }

  .ledger-register {
    margin-top: var(--rpgm-space-2);
  }
</style>
