---
import { getCollection } from "astro:content";
import Layout from "@rpgm/tools-press-theme/components/Layout.astro";
import ListFilter from "@rpgm/tools-press-theme/components/ListFilter.astro";
import Flourish from "@rpgm/tools-press-theme/ornaments/Flourish.astro";
import SiteHead from "../components/SiteHead.astro";
import FamilyNav from "../components/FamilyNav.astro";
import ReleaseRegister from "../components/ReleaseRegister.astro";
import { SITE_TITLE, SITE_TAGLINE, SITE_DESCRIPTION, SITE_LOGO, NAV_LINKS, REPO_URL } from "../consts";
import { enrolledRepos, familyOf } from "../lib/repos";

const allReleases = await getCollection("releases");
const releases = allReleases
  .filter((release) => familyOf(release.data.repo))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf() || a.id.localeCompare(b.id));

// Pinned to a fixed zone - see EntryCard.astro's identical comment for why.
const syncedAt = new Date().toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "America/Phoenix",
});
---

<Layout
  title="Home"
  description={SITE_DESCRIPTION}
  siteTitle={SITE_TITLE}
  logoSrc={SITE_LOGO}
  tagline={SITE_TAGLINE}
  navLinks={NAV_LINKS}
  rssTitle={SITE_TITLE}
  rssHref="/rss.xml"
  githubHref={REPO_URL}
>
  <Fragment slot="head">
    <SiteHead />
  </Fragment>

  <p class="rpgm-eyebrow">Latest releases</p>
  <Flourish size={16} color="var(--rpgm-border-strong)" variant="stamp" />
  <p class="ledger-receipt">
    {releases.length} entries across {enrolledRepos.length} repositories - last synchronized {syncedAt}.
  </p>
  <FamilyNav />
  <ListFilter slot="search" targetSelector=".ledger-register" placeholder="Search every release" />

  <ReleaseRegister releases={releases} />
</Layout>

<style>
  .ledger-receipt {
    margin: 0 0 var(--rpgm-space-5);
    font-family: var(--rpgm-font-mono);
    font-size: var(--rpgm-text-xs);
    color: var(--rpgm-text-muted);
    text-align: center;
  }
</style>
