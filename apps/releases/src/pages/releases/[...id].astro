---
import { getCollection, render } from "astro:content";
import Layout from "@rpgm/tools-press-theme/components/Layout.astro";
import Prose from "@rpgm/tools-press-theme/components/Prose.astro";
import Giscus from "@rpgm/tools-press-theme/components/Giscus.astro";
import Flourish from "@rpgm/tools-press-theme/ornaments/Flourish.astro";
import ProductSeal from "@rpgm/tools-press-theme/ornaments/ProductSeal.astro";
import SiteHead from "../../components/SiteHead.astro";
import DownloadList from "../../components/DownloadList.astro";
import { SITE_TITLE, SITE_LOGO, NAV_LINKS, GISCUS, MAIN_GAME_REPO, PLAY_NOW_URL, REPO_URL } from "../../consts";

export async function getStaticPaths() {
  const releases = await getCollection("releases");
  return releases.map((release) => ({
    params: { id: release.id },
    props: { release },
  }));
}

const { release } = Astro.props;
const { Content } = await render(release);

// Pinned to a fixed zone - see EntryCard.astro's identical comment for why.
const dateLabel = release.data.publishedAt.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "America/Phoenix",
});

const repoUrl = `https://github.com/${release.data.repo}`;
const isMod = release.data.kind === "mod";
---

<Layout
  title={`${release.data.repoDisplayName} ${release.data.version}`}
  description={`Release notes for ${release.data.repoDisplayName} ${release.data.version}.`}
  siteTitle={SITE_TITLE}
  logoSrc={SITE_LOGO}
  navLinks={NAV_LINKS}
  rssTitle={SITE_TITLE}
  rssHref="/rss.xml"
  githubHref={REPO_URL}
>
  <Fragment slot="head">
    <SiteHead />
  </Fragment>

  <article class="post-article">
    <p class="rpgm-eyebrow">{dateLabel}</p>
    <h1 class="release-title">
      {release.data.emoji && <ProductSeal emoji={release.data.emoji} size={40} color="var(--rpgm-accent)" />}
      <span>{release.data.repoDisplayName} {release.data.version}</span>
    </h1>
    <Flourish size={16} color="var(--rpgm-border-strong)" variant="stamp" />

    <Prose>
      <Content />
    </Prose>

    <DownloadList assets={release.data.assets} />

    <ul class="release-links">
      <li><a href={PLAY_NOW_URL}>Play Neo Angband now</a></li>
      <li><a href={release.data.url}>View this release on GitHub</a></li>
      <li><a href={repoUrl}>{release.data.repoDisplayName} on GitHub</a></li>
      {isMod && <li><a href={`https://github.com/${MAIN_GAME_REPO}`}>Neo Angband (the main game) on GitHub</a></li>}
    </ul>
  </article>

  {GISCUS.ready && (
    <Giscus
      repo={GISCUS.repo}
      repoId={GISCUS.repoId}
      category={GISCUS.category}
      categoryId={GISCUS.categoryId}
      mapping="specific"
      term={`${release.data.repo} ${release.data.version}`}
    />
  )}
</Layout>

<style>
  /* See the identical rule/comment on the blog's [...slug].astro - keeps the
     title/byline/downloads centered in the same column the Flourish already
     centers itself in, instead of only the ornament lining up. */
  .post-article {
    max-width: 42rem;
    margin: 0 auto;
  }

  .release-title {
    display: flex;
    align-items: center;
    gap: var(--rpgm-space-3);
  }

  .release-links {
    list-style: none;
    margin: var(--rpgm-space-6) 0 0;
    padding: var(--rpgm-space-4) 0 0;
    border-top: 1px solid var(--rpgm-border);
    display: grid;
    gap: var(--rpgm-space-2);
  }
</style>
