---
import { getCollection } from "astro:content";
import Layout from "@rpgm/tools-press-theme/components/Layout.astro";
import EntryCard from "@rpgm/tools-press-theme/components/EntryCard.astro";
import ProductSeal from "@rpgm/tools-press-theme/ornaments/ProductSeal.astro";
import SiteHead from "../../components/SiteHead.astro";
import { SITE_TITLE, SITE_LOGO, NAV_LINKS, REPO_URL } from "../../consts";
import { summarize } from "../../lib/summarize";
import repos from "../../../repos.json";

export async function getStaticPaths() {
  const allReleases = await getCollection("releases");

  return repos.map((tracked) => {
    const fullName = `${tracked.owner}/${tracked.repo}`;
    const filtered = allReleases
      .filter((release) => release.data.repo === fullName)
      .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf() || a.id.localeCompare(b.id));
    return {
      params: { repo: tracked.repo },
      props: { tracked, releases: filtered },
    };
  });
}

const { tracked, releases } = Astro.props;
---

<Layout
  title={tracked.displayName}
  description={`Releases for ${tracked.displayName}.`}
  siteTitle={SITE_TITLE}
  logoSrc={SITE_LOGO}
  navLinks={NAV_LINKS}
  rssTitle={SITE_TITLE}
  rssHref="/rss.xml"
  githubHref={REPO_URL}
>
  <Fragment slot="head">
    <SiteHead />
  </Fragment>

  <p class="rpgm-eyebrow">Repository</p>
  <h1 class="repo-title">
    {tracked.emoji && <ProductSeal emoji={tracked.emoji} size={40} color="var(--rpgm-accent)" />}
    <span>{tracked.displayName}</span>
  </h1>

  {
    releases.length === 0 ? (
      <p>No releases have synced for this repository yet.</p>
    ) : (
      <ul class="release-list">
        {releases.map((release) => (
          <li>
            <EntryCard
              title={release.data.version}
              href={`/releases/${release.id}/`}
              date={release.data.publishedAt}
              description={release.data.summary ?? summarize(release.body)}
              accentColor={tracked.color}
            />
          </li>
        ))}
      </ul>
    )
  }
</Layout>

<style>
  .repo-title {
    display: flex;
    align-items: center;
    gap: var(--rpgm-space-3);
  }

  .release-list {
    list-style: none;
    margin: var(--rpgm-space-6) 0 0;
    padding: 0;
    display: grid;
    gap: var(--rpgm-space-5);
  }
</style>
