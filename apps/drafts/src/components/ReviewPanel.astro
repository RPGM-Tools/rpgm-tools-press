---
import type { Claim } from "../lib/sidecar";

interface Props {
  slug: string;
  revision: number;
  changes: string[];
  claims: Claim[];
  meta: Record<string, unknown>;
  hasCover: boolean;
  share: { platform: string; fit: number; blurb: string }[];
}

const { slug, revision, changes, claims, meta, hasCover, share } = Astro.props;
const FIT = ["Weak fit", "Fits", "Strong fit"];
const shareSorted = [...share].sort((a, b) => b.fit - a.fit);
const gates = (meta.gates ?? {}) as Record<string, string>;
const KILL_REASONS = ["Wrong topic", "Boring", "Sounds like AI", "Too private", "Inaccurate", "Other"];
---

<section class="review" data-slug={slug} data-revision={revision}>
  <h2>Review</h2>
  <p class="review__status" data-status hidden></p>

  {
    changes.length > 0 && (
      <div class="review__block">
        <h3>What changed in this revision</h3>
        <ul>
          {changes.map((c) => (
            <li>{c}</li>
          ))}
        </ul>
      </div>
    )
  }

  <div class="review__block">
    <h3>Comments on passages</h3>
    <p class="review__hint">Select any text in the post to comment on it.</p>
    <ol class="review__comments" data-comments></ol>
  </div>

  <div class="review__block">
    <label for="review-notes"><h3>Notes</h3></label>
    <textarea id="review-notes" data-notes rows="5" placeholder="What should change? Everything here goes into the next revision."></textarea>
  </div>

  <div class="review__block review__row">
    <label for="review-rating">More posts like this?</label>
    <select id="review-rating" data-rating>
      <option value="">No opinion</option>
      <option value="0">Fewer</option>
      <option value="1">About the same</option>
      <option value="2">More</option>
    </select>
  </div>

  <div class="review__actions">
    <button type="button" class="review__btn review__btn--primary" data-action="approve">Approve and publish</button>
    <button type="button" class="review__btn" data-action="revise">Send notes</button>
    <button type="button" class="review__btn" data-action="park">Park</button>
    <button type="button" class="review__btn review__btn--danger" data-action="kill">Kill</button>
    {!hasCover && <button type="button" class="review__btn" data-action="cover">Make a cover</button>}
  </div>

  <div class="review__next" data-next hidden>
    <h3 data-next-title></h3>
    <p class="review__next-body" data-next-body></p>
    <p class="review__stage" data-stage aria-live="polite"></p>
    <button type="button" class="review__btn review__btn--primary" data-reload hidden>Read the new revision</button>
  </div>

  <fieldset class="review__block review__kill" data-kill hidden>
    <legend>Why kill it?</legend>
    {
      KILL_REASONS.map((r) => (
        <label class="review__chip">
          <input type="checkbox" value={r} data-kill-reason /> {r}
        </label>
      ))
    }
    <button type="button" class="review__btn review__btn--danger" data-confirm-kill>Kill this draft</button>
  </fieldset>

  {
    shareSorted.length > 0 && (
      <details class="review__block">
        <summary>Where to share it ({shareSorted.filter((s) => s.fit > 0).length} good fits)</summary>
        <ul class="review__share">
          {shareSorted.map((s) => (
            <li>
              <p class="review__claim">
                {s.platform} <span class="review__fit">{FIT[s.fit] ?? ""}</span>
              </p>
              <blockquote>{s.blurb}</blockquote>
              <button type="button" class="review__btn review__btn--small" data-copy={s.blurb}>
                Copy
              </button>
            </li>
          ))}
        </ul>
      </details>
    )
  }

  {
    claims.length > 0 && (
      <details class="review__block">
        <summary>Sources for every claim ({claims.length})</summary>
        <ol class="review__claims">
          {claims.map((c) => (
            <li>
              <p class="review__claim">{c.claim}</p>
              <blockquote>{c.evidence}</blockquote>
              {c.source && <p class="review__source">{c.source}</p>}
            </li>
          ))}
        </ol>
      </details>
    )
  }

  {
    Object.keys(gates).length > 0 && (
      <details class="review__block">
        <summary>Check results</summary>
        <dl class="review__gates">
          {Object.entries(gates).map(([k, v]) => (
            <>
              <dt>{k}</dt>
              <dd>{v}</dd>
            </>
          ))}
        </dl>
      </details>
    )
  }

  <button type="button" class="review__float" data-float hidden>Comment on selection</button>
</section>

<div class="review-toast" data-toast role="status" aria-live="polite" hidden></div>

<script>
  const panel = document.querySelector<HTMLElement>(".review")!;
  const slug = panel.dataset.slug!;
  const revision = Number(panel.dataset.revision);
  const statusEl = panel.querySelector<HTMLElement>("[data-status]")!;
  const commentsEl = panel.querySelector<HTMLOListElement>("[data-comments]")!;
  const floatBtn = panel.querySelector<HTMLButtonElement>("[data-float]")!;
  const article = document.querySelector<HTMLElement>("[data-review-target]")!;
  const draftKey = `review:${slug}:${revision}`;

  function showStatus(text: string, kind: "ok" | "error" | "info" = "info") {
    statusEl.textContent = text;
    statusEl.dataset.kind = kind;
    statusEl.hidden = false;
    // The status line sits at the top of the panel, often off screen, so the toast says it too.
    toast(text);
  }

  // Unsent notes survive a reload or a closed tab.
  function saveLocal() {
    try {
      const inline = [...commentsEl.querySelectorAll("li")].map((li) => ({
        quote: li.dataset.quote ?? "",
        note: li.querySelector("textarea")?.value ?? "",
      }));
      const notes = panel.querySelector<HTMLTextAreaElement>("[data-notes]")!.value;
      localStorage.setItem(draftKey, JSON.stringify({ inline, notes }));
    } catch {}
  }

  // Comment boxes grow with what is typed into them.
  function grow(ta: HTMLTextAreaElement) {
    ta.style.height = "auto";
    ta.style.height = `${ta.scrollHeight + 2}px`;
  }

  function addComment(quote: string, note = "") {
    const li = document.createElement("li");
    li.dataset.quote = quote;
    const q = document.createElement("blockquote");
    q.textContent = quote;
    const ta = document.createElement("textarea");
    ta.rows = 4;
    ta.value = note;
    ta.placeholder = "What's wrong with this passage?";
    ta.addEventListener("input", () => {
      grow(ta);
      saveLocal();
    });
    const rm = document.createElement("button");
    rm.type = "button";
    rm.className = "review__btn review__btn--small";
    rm.textContent = "Remove";
    rm.addEventListener("click", () => {
      li.remove();
      saveLocal();
    });
    li.append(q, ta, rm);
    commentsEl.append(li);
    grow(ta);
    return ta;
  }

  try {
    const saved = JSON.parse(localStorage.getItem(draftKey) ?? "null");
    if (saved) {
      saved.inline?.forEach((c: { quote: string; note: string }) => addComment(c.quote, c.note));
      panel.querySelector<HTMLTextAreaElement>("[data-notes]")!.value = saved.notes ?? "";
    }
  } catch {}
  panel.querySelector("[data-notes]")!.addEventListener("input", saveLocal);

  function selectedQuote() {
    const sel = window.getSelection();
    if (!sel || sel.isCollapsed || !sel.rangeCount) return "";
    if (!article.contains(sel.getRangeAt(0).commonAncestorContainer)) return "";
    return sel.toString().trim();
  }

  function placeFloat() {
    const quote = selectedQuote();
    if (quote.length < 3) {
      floatBtn.hidden = true;
      return;
    }
    const rect = window.getSelection()!.getRangeAt(0).getBoundingClientRect();
    floatBtn.style.top = `${window.scrollY + rect.bottom + 8}px`;
    floatBtn.style.left = `${Math.max(8, window.scrollX + rect.left)}px`;
    floatBtn.hidden = false;
  }
  document.addEventListener("selectionchange", () => setTimeout(placeFloat, 0));
  floatBtn.addEventListener("mousedown", (e) => e.preventDefault());
  floatBtn.addEventListener("click", () => {
    const quote = selectedQuote();
    if (!quote) return;
    const ta = addComment(quote);
    saveLocal();
    floatBtn.hidden = true;
    window.getSelection()?.removeAllRanges();
    ta.focus();
  });

  function collect() {
    const inline = [...commentsEl.querySelectorAll("li")]
      .map((li) => ({ quote: li.dataset.quote ?? "", note: li.querySelector("textarea")?.value.trim() ?? "" }))
      .filter((c) => c.quote);
    const notes = panel.querySelector<HTMLTextAreaElement>("[data-notes]")!.value.trim();
    const ratingRaw = panel.querySelector<HTMLSelectElement>("[data-rating]")!.value;
    return { notes, inline, rating: ratingRaw === "" ? null : Number(ratingRaw) };
  }

  const buttons = [...panel.querySelectorAll<HTMLButtonElement>("button")];

  async function send(action: string, extra: Record<string, unknown> = {}) {
    buttons.forEach((b) => (b.disabled = true));
    try {
      const res = await fetch("/api/review", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ slug, revision, action, ...collect(), ...extra }),
      });
      if (!res.ok) {
        const err = (await res.json().catch(() => ({}))) as { error?: string };
        throw new Error(err.error ?? `HTTP ${res.status}`);
      }
      try {
        localStorage.removeItem(draftKey);
      } catch {}
      statusEl.hidden = true;
      toast(NEXT[action]?.toast ?? "Sent.");
      showNext(action, "pending", new Date(), null, true);
    } catch (err) {
      showStatus(`Could not send: ${(err as Error).message}. Try again.`, "error");
      buttons.forEach((b) => (b.disabled = false));
    }
  }

  panel.querySelector('[data-action="approve"]')!.addEventListener("click", () => {
    if (confirm("Publish this post to blog.rpgm.tools now?")) send("approve");
  });
  panel.querySelector('[data-action="revise"]')!.addEventListener("click", () => {
    const { notes, inline } = collect();
    if (!notes && !inline.some((c) => c.note)) {
      showStatus("Add a note or a comment on a passage first.", "error");
      return;
    }
    send("revise");
  });
  panel.querySelector('[data-action="park"]')!.addEventListener("click", () => send("park"));
  panel.querySelector('[data-action="cover"]')?.addEventListener("click", () => send("cover"));
  panel.querySelector('[data-action="kill"]')!.addEventListener("click", () => {
    panel.querySelector<HTMLElement>("[data-kill]")!.hidden = false;
  });
  panel.querySelector("[data-confirm-kill]")!.addEventListener("click", () => {
    const reasons = [...panel.querySelectorAll<HTMLInputElement>("[data-kill-reason]:checked")].map((i) => i.value);
    send("kill", { reasons });
  });

  // After a submit, a card explains what happens next and follows the request
  // through the queue: waiting, being worked on, then done or failed.
  const NEXT: Record<string, { toast: string; title: string; body: string }> = {
    revise: {
      toast: "Notes received.",
      title: "Notes received",
      body: "The drafter looks for new notes every couple of minutes. Once it has yours, the rewrite takes about 5 to 10 minutes, and the new version replaces this page.",
    },
    approve: {
      toast: "Approved.",
      title: "Approved",
      body: "The drafter picks it up within a couple of minutes and adds it to the blog. The live link shows up here once the deploy finishes.",
    },
    park: { toast: "Parked.", title: "Parked", body: "It's off the queue. Tell the Blog chat when you want it back." },
    kill: { toast: "Killed.", title: "Killed", body: "It's off the queue, and your reasons are saved so ideas like it rank lower." },
    cover: {
      toast: "Sent.",
      title: "Cover requested",
      body: "Cover art is made in the browser, not on a schedule, so this can take a while. It shows up above the post here when it's done.",
    },
  };

  panel.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((b) =>
    b.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(b.dataset.copy ?? "");
        toast("Copied.");
      } catch {
        toast("Could not copy. Select the text and copy it by hand.");
      }
    }),
  );

  const toastEl = document.querySelector<HTMLElement>("[data-toast]")!;
  const nextEl = panel.querySelector<HTMLElement>("[data-next]")!;
  const stageEl = panel.querySelector<HTMLElement>("[data-stage]")!;
  const reloadBtn = panel.querySelector<HTMLButtonElement>("[data-reload]")!;
  reloadBtn.addEventListener("click", () => location.reload());
  let toastTimer = 0;
  let pollTimer = 0;

  function toast(text: string) {
    toastEl.textContent = text;
    toastEl.hidden = false;
    toastEl.classList.add("is-shown");
    clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => {
      toastEl.classList.remove("is-shown");
      window.setTimeout(() => (toastEl.hidden = true), 300);
    }, 4000);
  }

  const clock = (d: Date) => d.toLocaleTimeString([], { hour: "numeric", minute: "2-digit" });
  // D1 stores "YYYY-MM-DD HH:MM:SS" in UTC.
  const fromDb = (s: string) => new Date(s.replace(" ", "T") + "Z");

  function setStage(action: string, status: string, since: Date, result?: string | null) {
    reloadBtn.hidden = true;
    if (status === "pending") stageEl.textContent = `Waiting in the queue since ${clock(since)}.`;
    else if (status === "working") stageEl.textContent = "The drafter is working on it now.";
    else if (status === "failed") stageEl.textContent = `That didn't work${result ? `: ${result}` : ""}. Your notes are still in the queue.`;
    else if (action === "revise") {
      stageEl.textContent = "Done. Reload to read it.";
      reloadBtn.hidden = false;
    } else if (action === "approve") stageEl.textContent = result ? `It's live: ${result}` : "It's live on the blog.";
    else stageEl.textContent = "Done.";
    stageEl.dataset.status = status;
  }

  function showNext(action: string, status: string, since: Date, result?: string | null, scroll = false) {
    const n = NEXT[action];
    if (!n) return;
    panel.querySelector("[data-next-title]")!.textContent = n.title;
    panel.querySelector("[data-next-body]")!.textContent = n.body;
    // A cover request runs alongside the review, so it only locks its own button.
    if (action === "cover") buttons.forEach((b) => (b.disabled = b.dataset.action === "cover"));
    else buttons.forEach((b) => (b.disabled = b !== reloadBtn));
    nextEl.hidden = false;
    setStage(action, status, since, result);
    if (scroll) nextEl.scrollIntoView({ behavior: "smooth", block: "center" });
    clearInterval(pollTimer);
    if (status === "pending" || status === "working") pollTimer = window.setInterval(poll, 20000);
  }

  type Latest = { action: string; status: string; created_at: string; result: string | null } | null;
  async function latest(): Promise<Latest> {
    const r = await fetch(`/api/status?slug=${encodeURIComponent(slug)}&revision=${revision}`);
    return r.ok ? ((await r.json()) as { latest: Latest }).latest : null;
  }

  async function poll() {
    try {
      const l = await latest();
      if (!l) return;
      setStage(l.action, l.status, fromDb(l.created_at), l.result);
      if (l.status !== "pending" && l.status !== "working") clearInterval(pollTimer);
    } catch {}
  }

  // A request already sent for this revision shows its progress card on load.
  latest()
    .then((l) => {
      if (l) showNext(l.action, l.status, fromDb(l.created_at), l.result);
    })
    .catch(() => {});
</script>

<style>
  .review {
    max-width: 42rem;
    margin: var(--rpgm-space-8) auto 0;
    padding: var(--rpgm-space-4);
    border: 1px solid var(--rpgm-border-strong);
    border-radius: var(--rpgm-radius-md, 8px);
    background: color-mix(in srgb, var(--rpgm-accent) 4%, transparent);
  }
  .review h2,
  .review h3 {
    margin-top: 0;
  }
  .review h3 {
    font-size: var(--rpgm-text-base, 1rem);
    margin-bottom: var(--rpgm-space-2);
  }
  .review__block {
    margin-bottom: var(--rpgm-space-4);
  }
  .review__hint,
  .review__source {
    color: var(--rpgm-text-muted);
    font-size: var(--rpgm-text-sm);
    margin: 0 0 var(--rpgm-space-2);
  }
  /* Comment boxes are created in the browser, so they need :global to pick these up. */
  .review :global(textarea),
  .review select {
    width: 100%;
    box-sizing: border-box;
    font: inherit;
    color: var(--rpgm-text);
    background: var(--rpgm-surface, transparent);
    border: 1px solid var(--rpgm-border);
    border-radius: 6px;
    padding: var(--rpgm-space-2);
  }
  .review__row {
    display: flex;
    gap: var(--rpgm-space-3);
    align-items: center;
  }
  .review__row select {
    width: auto;
  }
  .review__comments {
    padding-left: 1.2em;
  }
  .review__comments :global(li) {
    margin-bottom: var(--rpgm-space-3);
  }
  .review__comments :global(textarea) {
    min-height: 6.5em;
    resize: vertical;
  }
  .review__next {
    margin-bottom: var(--rpgm-space-4);
    padding: var(--rpgm-space-3) var(--rpgm-space-4);
    border: 1px solid var(--rpgm-accent);
    border-radius: 8px;
    background: color-mix(in srgb, var(--rpgm-accent) 8%, transparent);
  }
  .review__next-body {
    margin: 0 0 var(--rpgm-space-3);
  }
  .review__stage {
    margin: 0 0 var(--rpgm-space-2);
    font-weight: 600;
  }
  .review__stage[data-status="pending"]::before,
  .review__stage[data-status="working"]::before {
    content: "";
    display: inline-block;
    width: 0.6em;
    height: 0.6em;
    margin-right: 0.5em;
    border-radius: 50%;
    background: var(--rpgm-accent);
    animation: review-pulse 1.4s ease-in-out infinite;
  }
  @keyframes review-pulse {
    50% {
      opacity: 0.25;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .review__stage::before {
      animation: none;
    }
  }
  .review-toast {
    position: fixed;
    left: 50%;
    bottom: 24px;
    z-index: 20;
    transform: translate(-50%, 16px);
    opacity: 0;
    transition:
      opacity 0.25s ease,
      transform 0.25s ease;
    padding: 0.7em 1.4em;
    border-radius: 999px;
    border: 1px solid var(--rpgm-accent);
    background: var(--rpgm-bg, #1b1612);
    color: var(--rpgm-text);
    font-weight: 600;
    box-shadow: 0 4px 16px rgb(0 0 0 / 0.35);
  }
  .review-toast.is-shown {
    opacity: 1;
    transform: translate(-50%, 0);
  }
  .review :global(blockquote) {
    margin: 0 0 var(--rpgm-space-2);
    padding-left: var(--rpgm-space-3);
    border-left: 2px solid var(--rpgm-border-strong);
    color: var(--rpgm-text-muted);
  }
  .review__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--rpgm-space-2);
    margin-bottom: var(--rpgm-space-4);
  }
  .review__btn,
  .review :global(.review__btn) {
    font: inherit;
    font-size: var(--rpgm-text-sm);
    padding: 0.5em 1em;
    min-height: 44px;
    border-radius: 6px;
    border: 1px solid var(--rpgm-border-strong);
    background: transparent;
    color: var(--rpgm-text);
    cursor: pointer;
  }
  .review :global(.review__btn--small) {
    min-height: 32px;
    padding: 0.2em 0.7em;
  }
  .review__btn--primary {
    background: var(--rpgm-accent);
    border-color: var(--rpgm-accent);
    color: var(--rpgm-bg, #fff);
  }
  .review__btn--danger {
    border-color: #8b1a1a;
    color: #c0392b;
  }
  .review__btn:disabled {
    opacity: 0.5;
    cursor: default;
  }
  .review__kill {
    border: 1px solid var(--rpgm-border);
    border-radius: 6px;
    display: flex;
    flex-wrap: wrap;
    gap: var(--rpgm-space-2);
    align-items: center;
  }
  .review__chip {
    border: 1px solid var(--rpgm-border);
    border-radius: var(--rpgm-radius-full);
    padding: 0.2em 0.8em;
    font-size: var(--rpgm-text-sm);
  }
  .review__status {
    padding: var(--rpgm-space-2) var(--rpgm-space-3);
    border-radius: 6px;
    border: 1px solid var(--rpgm-border);
  }
  .review__status[data-kind="ok"] {
    border-color: #35513f;
  }
  .review__status[data-kind="error"] {
    border-color: #8b1a1a;
  }
  .review__claims li {
    margin-bottom: var(--rpgm-space-3);
  }
  .review__claim {
    margin: 0 0 var(--rpgm-space-1, 4px);
    font-weight: 600;
  }
  .review__share {
    list-style: none;
    padding: 0;
  }
  .review__share li {
    margin-bottom: var(--rpgm-space-3);
  }
  .review__fit {
    font-weight: 400;
    font-size: var(--rpgm-text-xs);
    color: var(--rpgm-text-muted);
    margin-left: var(--rpgm-space-2);
  }
  .review__gates dt {
    font-weight: 600;
  }
  .review__gates dd {
    margin: 0 0 var(--rpgm-space-2);
    color: var(--rpgm-text-muted);
  }
  .review__float {
    position: absolute;
    z-index: 10;
    font: inherit;
    font-size: var(--rpgm-text-sm);
    padding: 0.4em 0.9em;
    border-radius: 6px;
    border: 1px solid var(--rpgm-accent);
    background: var(--rpgm-accent);
    color: var(--rpgm-bg, #fff);
    box-shadow: 0 2px 8px rgb(0 0 0 / 0.3);
  }
</style>
